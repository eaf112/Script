local factories = {}
factories["prompt_focus"] = (function()
return function(env)
	local M, state = {}, nil
	local function watch(event, field)
		env.window:Give(env.prompts[event]:Connect(function(prompt)
			local s = state
			if s and s.prompt == prompt then s[field] = env.clock() end
		end))
	end
	watch("PromptShown", "shown")
	watch("PromptHidden", "hidden")
	watch("PromptButtonHoldBegan", "began")
	watch("PromptButtonHoldEnded", "ended")
	watch("PromptTriggered", "triggered")
	local function position(prompt)
		local parent = prompt.Parent
		if not parent then return nil end
		if parent:IsA("Attachment") then return parent.WorldPosition, parent.Parent end
		if parent:IsA("BasePart") then return parent.Position, parent end
		if parent:IsA("Model") and parent.PrimaryPart then return parent.PrimaryPart.Position, parent.PrimaryPart end
	end
	local function visible(origin, target, part, char)
		local delta = target - origin
		if delta.Magnitude < 0.1 then return false end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {char}
		local hit = env.world:Raycast(origin, delta, params)
		return not hit or hit.Instance == part
	end
	function M.stop()
		local s = state
		state = nil
		if not s then return end
		if s.sent then pcall(function() s.prompt:InputHoldEnd() end) end
		pcall(function()
			if env.world.CurrentCamera == s.camera and s.camera.CameraType == Enum.CameraType.Scriptable then
				s.camera.CameraType = s.kind
			end
		end)
	end
	function M.start(prompt, char)
		M.stop()
		local camera = env.world.CurrentCamera
		local root = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head") or root
		local target, part = position(prompt)
		if not camera or not root or not head or not target then return false, "프롬프트 시야 대상을 찾지 못했습니다" end
		if camera.CameraType == Enum.CameraType.Scriptable then return false, "다른 카메라 연출이 진행 중입니다" end
		if not env.prompts.Enabled then return false, "게임의 프롬프트 서비스가 비활성화되어 있습니다" end
		local eye
		for _, offset in ipairs({Vector3.new(), Vector3.new(0, 0.5, 0)}) do
			local candidate = head.Position + offset
			if not prompt.RequiresLineOfSight or visible(candidate, target, part, char) then eye = candidate; break end
		end
		if not eye or (target - eye).Magnitude < 0.1 then return false, "캐릭터 눈높이에서 대상 시야가 막혀 있습니다" end
		local delta = target - eye
		local up = math.abs(delta.Unit.Y) > 0.98 and Vector3.new(0, 0, 1) or Vector3.new(0, 1, 0)
		local s = {camera = camera, root = root, char = char, prompt = prompt, part = part,
			at = env.clock(), kind = camera.CameraType, target = target, origin = root.Position}
		state = s
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = CFrame.lookAt(eye, target, up)
		camera.Focus = CFrame.new(target)
		return true
	end
	function M.tick()
		local s = state
		if not s then return "error", "프롬프트 시야 작업이 없습니다" end
		local now = env.clock()
		if env.player.Character ~= s.char or not s.root.Parent or not s.prompt.Parent or not s.prompt.Enabled then return "error", "캐릭터 또는 프롬프트 상태가 바뀌었습니다" end
		if env.world.CurrentCamera ~= s.camera or s.camera.CameraType ~= Enum.CameraType.Scriptable then return "error", "다른 카메라 제어가 시작되었습니다" end
		local target, part = position(s.prompt)
		if not target or (target - s.root.Position).Magnitude > s.prompt.MaxActivationDistance then return "error", "프롬프트 상호작용 거리를 벗어났습니다" end
		if (s.root.Position - s.origin).Magnitude > 1.5 or (target - s.target).Magnitude > 0.5 then return "error", "캐릭터나 대상이 움직여 시야를 다시 확인해야 합니다" end
		local point, onScreen = s.camera:WorldToViewportPoint(target)
		local clear = not s.prompt.RequiresLineOfSight or visible(s.camera.CFrame.Position, target, part, s.char)
		if onScreen and point.Z > 0 and clear then
			s.stableAt = s.stableAt or now
			if now - s.stableAt >= 0.3 then return "ready" end
		else s.stableAt = nil end
		if now - s.at >= 4 then return "error", "프롬프트가 화면 안에서 안정적으로 보이지 않습니다" end
		return "waiting"
	end
	function M.begin()
		local status, why = M.tick()
		if status ~= "ready" then return false, why or "프롬프트 시야가 아직 준비되지 않았습니다" end
		local s = state
		if s.sent then return false, "이미 프롬프트 누르기를 시작했습니다" end
		s.sent, s.sentAt = true, env.clock()
		s.began, s.ended, s.triggered, s.hidden = nil, nil, nil, nil
		local ok, err = pcall(function() s.prompt:InputHoldBegin() end)
		if not ok then M.stop(); return false, tostring(err) end
		return true
	end
	function M.holdStatus()
		local s = state
		if not s or not s.sent then return "error", "누르기 입력이 시작되지 않았습니다" end
		if s.triggered then return "triggered" end
		local now = env.clock()
		if now - s.sentAt >= 0.75 and not s.began then return "error", "InputHoldBegin을 호출했지만 게임의 누르기 시작 이벤트가 없습니다" end
		if (s.hidden and now - s.hidden >= 0.25) or (s.ended and now - s.ended >= 0.25) then return "error", "프롬프트가 숨겨지거나 누르기가 취소되어 실행되지 않았습니다" end
		local status, why = M.tick()
		if status == "error" then return status, why end
		return "holding"
	end
	function M.snapshot()
		local s = state
		return s and {shown = s.shown ~= nil, began = s.began ~= nil, triggered = s.triggered ~= nil, sent = s.sent == true} or nil
	end
	env.window:OnDestroy(M.stop)
	return M
end
end)()
factories["movement"] = (function()
return function(env)
	local M = {}
	function M.teleport(part, reach, char, human, root)
		human:MoveTo(root.Position); human:Move(Vector3.new())
		local ray, vision, overlap = RaycastParams.new(), RaycastParams.new(), OverlapParams.new()
		ray.FilterType, vision.FilterType, overlap.FilterType = Enum.RaycastFilterType.Exclude, Enum.RaycastFilterType.Exclude, Enum.RaycastFilterType.Exclude
		ray.FilterDescendantsInstances, vision.FilterDescendantsInstances, overlap.FilterDescendantsInstances = {char, part}, {char}, {char, part}
		ray.RespectCanCollide, overlap.RespectCanCollide = true, true
		local offsets, radius = {}, math.min(5, math.max(1, reach * 0.45))
		for _, radiusNow in ipairs({radius, math.min(8, radius + 2), 0}) do
			for i = 0, 7 do
				local angle = i * math.pi / 4
				offsets[#offsets + 1] = Vector3.new(math.cos(angle) * radiusNow, 0, math.sin(angle) * radiusNow)
				if radiusNow == 0 then break end
			end
		end
		table.sort(offsets, function(a, b) return (part.Position + a - root.Position).Magnitude < (part.Position + b - root.Position).Magnitude end)
		local height = human.HipHeight + root.Size.Y / 2 + (human.RigType == Enum.HumanoidRigType.R6 and 2 or 0) + 0.1
		for _, offset in ipairs(offsets) do
			local floor = env.world:Raycast(part.Position + offset + Vector3.new(0, 3, 0), Vector3.new(0, -40, 0), ray)
			if floor and floor.Normal.Y > 0.6 then
				local goal = floor.Position + Vector3.new(0, height, 0)
				if (goal - part.Position).Magnitude < reach - 0.3 then
					local blocked = false
					for _, object in ipairs(env.world:GetPartBoundsInBox(CFrame.new(goal + Vector3.new(0, 0.6, 0)), Vector3.new(3, 4, 3), overlap)) do
						if object.CanCollide then blocked = true; break end
					end
					local eye = goal + Vector3.new(0, 1.5, 0)
					local hit = env.world:Raycast(eye, part.Position - eye, vision)
					if not blocked and (not hit or hit.Instance == part) then
						char:PivotTo(char:GetPivot() + (goal - root.Position))
						root.AssemblyLinearVelocity = Vector3.new()
						human:MoveTo(goal)
						return goal
					end
				end
			end
		end
		return nil, "문서 근처에 바닥·빈 공간·시야를 확보하지 못했습니다"
	end
	return M
end
end)()
