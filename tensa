local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup = {}
for i = 1, #alphabet do
	lookup[string.byte(alphabet, i)] = i - 1
end
local function decode(value)
	local out = {}
	for i = 1, #value, 4 do
		local a, b, c, d = string.byte(value, i, i + 3)
		local n = lookup[a] * 262144 + lookup[b] * 4096 + (lookup[c] or 0) * 64 + (lookup[d] or 0)
		local first = math.floor(n / 65536) % 256
		local second = math.floor(n / 256) % 256
		local third = n % 256
		if c == 61 then
			out[#out + 1] = string.char(first)
		elseif d == 61 then
			out[#out + 1] = string.char(first, second)
		else
			out[#out + 1] = string.char(first, second, third)
		end
	end
	return table.concat(out)
end
