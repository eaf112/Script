local function part(parent, name, meshId, textureId, meshScale)
	local value = Instance.new("Part")
	value.Name = name
	value.Anchored = true
	value.CanCollide = false
	value.CanTouch = false
	value.CanQuery = false
	value.CastShadow = false
	value.Size = Vector3.new(0.05, 0.05, 0.05)
	value.Color = textureId and Color3.new(1, 1, 1) or Color3.fromRGB(38, 39, 45)
	value.Material = textureId and Enum.Material.SmoothPlastic or Enum.Material.Metal
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.FileMesh
	mesh.MeshId = meshId
	mesh.Scale = Vector3.new(meshScale, meshScale, meshScale)
	if textureId then
		mesh.TextureId = textureId
	end
	mesh.Parent = value
	value.Parent = parent
	return value
end

local function restore(rig)
	for object, original in pairs(rig.hidden) do
		pcall(function()
			if object.LocalTransparencyModifier == 1 then
				object.LocalTransparencyModifier = original
			end
		end)
	end
	rig.hidden = {}
end

local function destroyRig(key)
	local rig = rigs[key]
	if not rig then
		return
	end
	rigs[key] = nil
	if rig.added then
		rig.added:Disconnect()
	end
	if rig.removing then
		rig.removing:Disconnect()
	end
	restore(rig)
	rig.model:Destroy()
end

function controller:Destroy()
	if not alive then
		return
	end
	alive = false
	RunService:UnbindFromRenderStep(renderName)
	local keys = {}
	for key in pairs(rigs) do
		keys[#keys + 1] = key
	end
	for _, key in ipairs(keys) do
		destroyRig(key)
	end
	folder:Destroy()
	if shared.KatanaSkin == self then
		shared.KatanaSkin = nil
	end
end

function controller:Status()
	local count, hidden, rows = 0, 0, {}
	for _, rig in pairs(rigs) do
		count = count + 1
		for _ in pairs(rig.hidden) do
			hidden = hidden + 1
		end
		rows[#rows + 1] = {source = rig.source and rig.source:GetFullName() or rig.weld.Part0:GetFullName(), mode = rig.mode, links = #rig.links, steps = rig.steps, resets = rig.resets}
	end
	return {alive = alive, enabled = self.Enabled, rigs = count, hidden = hidden, frames = frames, error = failure, sources = rows}
end

local function createRig(joint, source, target)
	local model = Instance.new("Model")
	model.Name = "사슬 검"
	local rig = {model = model, source = source, joint = joint, hidden = {}, points = {}, old = {}, links = {}, steps = 0, resets = 0, accumulator = 0}
	local ok, result = pcall(function()
		rig.body = part(model, "검", assetUris[1], assetUris[3], scale)
		rig.body.Massless = true
		rig.body.RootPriority = -127
		rig.body.CFrame = target.frame.CFrame * target.offset
		rig.body.Anchored = false
		rig.weld = Instance.new("Weld")
		rig.weld.Name = "외형 연결"
		rig.weld.Part0 = target.frame
		rig.weld.Part1 = rig.body
		rig.weld.C0 = target.offset
		rig.weld.Parent = rig.body
		rig.alignment = target.alignment
		for i = 1, linkCount do
			rig.links[i] = part(model, "사슬 " .. i, assetUris[2], nil, scale)
		end
		local function remember(object)
			if object:IsA("BasePart") then
				rig.hidden[object] = object.LocalTransparencyModifier
			end
		end
		if source then
			for _, object in ipairs(source:GetDescendants()) do
				remember(object)
			end
			rig.added = source.DescendantAdded:Connect(remember)
			rig.removing = source.DescendantRemoving:Connect(function(object)
				local original = rig.hidden[object]
				if original ~= nil then
					pcall(function()
						if object.LocalTransparencyModifier == 1 then
							object.LocalTransparencyModifier = original
						end
					end)
					rig.hidden[object] = nil
				end
			end)
		end
		model.Parent = folder
		return rig
	end)
	if not ok then
		if rig.added then
			rig.added:Disconnect()
		end
		if rig.removing then
			rig.removing:Disconnect()
		end
		restore(rig)
		model:Destroy()
		error(result)
	end
	rigs[joint] = result
	return result
end

local function reset(rig, base, anchor)
	local direction = base:VectorToWorldSpace(Vector3.new(0.35, -0.9, 0)).Unit
	for i = 1, linkCount + 1 do
		local point = anchor + direction * ((i - 1) * distance)
		rig.points[i] = point
		rig.old[i] = point
	end
	rig.lastAnchor = anchor
	rig.simAnchor = anchor
	rig.accumulator = 0
	rig.resets = rig.resets + 1
end

local function simulate(rig, base, anchor, dt)
	local points, old = rig.points, rig.old
	if not rig.lastAnchor or (anchor - rig.lastAnchor).Magnitude > 3 or dt > 0.25 then
		reset(rig, base, anchor)
	end
	local step = 1 / 120
	rig.accumulator = math.min(rig.accumulator + dt, step * 8)
	local steps = math.floor(rig.accumulator / step)
	rig.accumulator = rig.accumulator - steps * step
	local origin = rig.simAnchor
	for index = 1, steps do
		local target = origin:Lerp(anchor, index / steps)
		points[1] = target
		for i = 2, linkCount + 1 do
			local now = points[i]
			points[i] = now + (now - old[i]) * 0.977 + Vector3.new(0, -22, 0) * (step * step)
			old[i] = now
		end
		for _ = 1, 8 do
			points[1] = target
			for i = 1, linkCount do
				local delta = points[i + 1] - points[i]
				local length = delta.Magnitude
				local correction = (length > 0.00001 and delta / length or Vector3.new(0, -1, 0)) * (length - distance)
				if i == 1 then
					points[i + 1] = points[i + 1] - correction
				else
					points[i] = points[i] + correction * 0.5
					points[i + 1] = points[i + 1] - correction * 0.5
				end
			end
		end
		points[1] = target
		for i = 1, linkCount do
			local delta = points[i + 1] - points[i]
			points[i + 1] = points[i] + (delta.Magnitude > 0.00001 and delta.Unit or Vector3.new(0, -1, 0)) * distance
		end
		rig.steps = rig.steps + 1
	end
	if steps > 0 then
		rig.simAnchor = anchor
	end
	local shift = anchor - points[1]
	for i = 1, linkCount do
		local a = points[i] + shift
		local b = points[i + 1] + shift
		local delta = b - a
		if delta.Magnitude > 0.00001 then
			local up = base.ZVector
			if math.abs(delta.Unit:Dot(up)) > 0.95 then
				up = base.YVector
			end
			local cf = CFrame.lookAt((a + b) * 0.5, b, up)
			if i % 2 == 0 then
				cf = cf * CFrame.Angles(0, 0, math.pi * 0.5)
			end
			rig.links[i].CFrame = cf
		end
	end
	rig.lastAnchor = anchor
end

local function update(dt)
	frames = frames + 1
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local weapon
	local available = character and humanoid and humanoid.Health > 0 and controller.Enabled and character.Parent
	if available then
		for _, object in ipairs(character:GetChildren()) do
			if object:IsA("Tool") and object:GetAttribute("IsWeapon") == true then
				weapon = object
				break
			end
		end
	end
	local active = {}
	local workshop = workspace:FindFirstChild("CharacterWorkshop")
	if weapon and workshop then
		for _, name in ipairs({"RightHand", "LeftHand", "Head"}) do
			local hand = character:FindFirstChild(name)
			if hand then
				for _, joint in ipairs(hand:GetChildren()) do
					if joint.Name == "Real Sword_6D" and joint:IsA("Motor6D") and joint.Part0 == hand and joint.Part1 then
						local source = joint.Part1:FindFirstAncestorOfClass("Model")
						local owner = source
						while owner and owner.Parent ~= workshop do
							owner = owner.Parent
						end
						if source and owner and owner.Name == player.Name .. "Real Sword" then
							active[joint] = {source = source, frame = joint.Part1, offset = orientation, alignment = joint.Part1, mode = "장착"}
						end
					end
				end
			end
		end
	end
	if available and not weapon then
		local fake = character:FindFirstChild("Fake Sword")
		local waist = character:FindFirstChild("LowerTorso")
		local backpack = player:FindFirstChildOfClass("Backpack")
		local carried
		if backpack then
			for _, object in ipairs(backpack:GetChildren()) do
				if object:IsA("Tool") and object:GetAttribute("IsWeapon") == true then
					carried = object
					break
				end
			end
		end
		if waist and waist:IsA("BasePart") and carried then
			local offset = CFrame.new(-waist.Size.X * 0.5 - 0.22, waist.Size.Y * 0.15, 0.1) * CFrame.Angles(math.rad(12), math.pi * 0.5, 0) * CFrame.new(-palm)
			active[waist] = {source = fake and fake:IsA("Model") and fake or nil, frame = waist, offset = offset, alignment = waist.Size, mode = "수납"}
		end
	end
	local remove = {}
	for key, rig in pairs(rigs) do
		if not active[key] or active[key].source ~= rig.source or rig.weapon ~= weapon or rig.model.Parent ~= folder or not rig.body.Parent or rig.weld.Parent ~= rig.body or rig.weld.Part1 ~= rig.body then
			remove[#remove + 1] = key
		end
	end
	for _, key in ipairs(remove) do
		destroyRig(key)
	end
	for key, target in pairs(active) do
		local rig = rigs[key] or createRig(key, target.source, target)
		rig.weapon = weapon
		rig.mode = target.mode
		if rig.weld.Part0 ~= target.frame or rig.alignment ~= target.alignment then
			rig.weld.Part0 = target.frame
			rig.weld.C0 = target.offset
			rig.alignment = target.alignment
			rig.lastAnchor = nil
		end
		local base = rig.body:GetRenderCFrame()
		simulate(rig, base, base:PointToWorldSpace(anchorLocal), dt)
		for object, original in pairs(rig.hidden) do
			local current = object.LocalTransparencyModifier
			if current ~= 1 then
				if current ~= original then
					rig.hidden[object] = current
				end
				object.LocalTransparencyModifier = 1
			end
		end
	end
end

shared.KatanaSkin = controller
RunService:BindToRenderStep(renderName, Enum.RenderPriority.Last.Value + 1, function(dt)
	if alive then
		local ok, reason = pcall(update, dt)
		if not ok then
			failure = tostring(reason)
			controller:Destroy()
			warn("검 외형 적용을 중지하고 복구했습니다: " .. failure)
		end
	end
end)
return controller:Status()
