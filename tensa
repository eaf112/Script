local scale = 3.5
local linkCount = 8
local distance = 0.16
local palm = Vector3.new(0.69, 0.073, 0) * scale
local anchorLocal = Vector3.new(0.930, 0.073, 0) * scale
local orientation = CFrame.Angles(0, -math.pi * 0.5, 0) * CFrame.new(-palm)
local folder = Instance.new("Folder")
folder.Name = "검 외형"
folder.Parent = workspace
