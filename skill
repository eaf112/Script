local ComboPlanner = (function(env)
	local M = {}
	-- 운용 거리는 연계 선택 기준이며 서버 판정 사거리는 아닙니다.
	local profiles = {
		RumbleRumble = {
			Z = {kind = "quick", priority = 100, recovery = 0.26, label = "빠른 견제"},
			X = {kind = "burst", priority = 78, recovery = 0.28, charge = 0.72, label = "후속 공격"},
			C = {kind = "quick", priority = 66, recovery = 0.27, label = "후속 공격"},
			V = {kind = "finish", priority = 52, recovery = 0.3, charge = 3.02, label = "큰 기술 연결"},
			E = {kind = "utility", priority = 25, recovery = 0.3, charge = 1.02, label = "상황 기술"},
		},
		Trickster = {
			Z = {kind = "quick", priority = 85, recovery = 0.18, label = "빠른 후속기", limit = 65},
			X = {kind = "dash", priority = 75, recovery = 0.2, label = "거리 좁히기", limit = 180},
			C = {kind = "channel", priority = 58, recovery = 0.25, channel = 2, label = "지속 공격", limit = 90},
			V = {kind = "finish", priority = 65, recovery = 0.25, label = "후속 공격", limit = 90},
			E = {kind = "burst", priority = 60, recovery = 0.25, label = "후속 공격", limit = 90},
		},
		Acrodagger = {
			Z = {kind = "charge", priority = 90, recovery = 0.14, charge = 0.53, label = "짧게 놓기 / 차징"},
			X = {kind = "catch", priority = 95, recovery = 0.27, label = "대상 지정 후속기", limit = 250},
		},
	}
	function M.Profile(tool, key, awake, metadata)
		local source = profiles[tool] and profiles[tool][key]
		local meta = metadata or {}
		local cooldown = tonumber(meta.cooldown) or 8
		local profile = {kind = "quick", priority = math.max(25, math.min(90, 95 - cooldown * 3)), recovery = 0.2, hold = 0.05,
			label = "자동 분석 후속기", source = "게임 스킬 데이터", cooldown = cooldown}
		local hints = (meta.hints or ""):lower()
		if hints:find("findnearesttarget", 1, true) then
			profile.kind, profile.priority, profile.label = "catch", 92, "대상 지정 후속기"
		elseif hints:find("shambles", 1, true) or hints:find("teleport", 1, true) or hints:find("dash", 1, true) then
			profile.kind, profile.label = "dash", "이동 기술 연결"
		elseif hints:find("charge", 1, true) or hints:find("hold", 1, true) then
			profile.kind, profile.label = "charge", "짧게 놓는 후속기"
		end
		if source then for k, v in pairs(source) do profile[k] = v end end
		if source then profile.source = "확인한 기술별 설정" end
		if tool == "OpOp" and key == "Z" then
			profile.kind, profile.priority, profile.label = "setup", 180, "룸 준비"
		end
		if tool == "RumbleRumble" then
			if key == "C" and awake then profile.kind, profile.label, profile.limit = "dash", "거리 좁히기", 240 end
			if not awake then profile.charge = nil end
		end
		return profile
	end
	function M.IsCanceled(alive, stopped, capturedEpoch, currentEpoch, autoToken, autoEnabled, autoEpoch)
		return not alive or stopped or capturedEpoch ~= currentEpoch
			or autoToken ~= nil and (not autoEnabled or autoToken ~= autoEpoch)
	end
	function M.Duel(localName, friendly, opponentName, opponentFriendly, opponentSolo)
		if friendly ~= true then return {active = false, ready = false} end
		local named = type(opponentName) == "string" and opponentName ~= "" and opponentName ~= localName
		local ready = named and opponentFriendly == true and opponentSolo == localName
		return {active = true, name = named and opponentName or nil, ready = ready == true,
			reason = ready and "결투 상대 고정" or "결투 상대 확인 대기"}
	end
	function M.DuelCastBlocked(capturedEpoch, currentEpoch, protected, active, hasHit)
		return capturedEpoch ~= currentEpoch or (protected or active) and not hasHit
	end
	function M.HoldReady(cast, hold, now)
		return now >= (cast.downAt or cast.started + 0.5) + hold
	end
	function M.CanAdvance(cast, decision, now, doing, charging)
		if not cast.released or not (cast.upAt or cast.callReturned and cast.downAt) or doing or charging then return false end
		local releasedAt = cast.releasedAt or now
		return now >= math.max(releasedAt, cast.upAt or releasedAt) + decision.recovery
	end

	function M.Choose(skills, context)
		local diagnostics = {skills = {}, count = #skills}
		if not context.valid then return nil, "조준 대상 대기", diagnostics end
		if context.distance > (context.aimRange or context.maxDistance) then return nil, "조준 거리 밖", diagnostics end
		local chosen, decision, highest
		for _, skill in ipairs(skills) do
			local p, distance = skill.profile, context.distance
			local eligible, preferred = true, true
			local hold, score, role = p.hold or 0.05, p.priority, p.label
			local notes = {}
			local function prefer(condition, penalty, reason)
				if not condition then
					preferred = false
					score = score - penalty
					notes[#notes + 1] = reason
				end
			end
			prefer(distance <= context.maxDistance, math.min(100, math.max(0, distance - context.maxDistance) / 8), "콤보 우선 거리 밖")
			if p.limit then prefer(distance <= p.limit, math.min(50, math.max(0, distance - p.limit) / 6), "스킬 우선 거리 밖") end
			local feedback = context.feedback[skill.settingId]
			local ccRate = feedback and feedback.cc / math.max(1, feedback.attempts) or 0
			if p.kind == "dash" then
				if not context.allowDash then eligible = false; notes[#notes + 1] = "돌진 사용 설정 꺼짐" end
				prefer(distance > 55 and not context.stunned, 80, "근접 돌진 후순위")
				score = score + (distance > 90 and 45 or -20)
			elseif p.kind == "channel" then
				prefer(context.stunned and context.remaining >= 0.45, 35, "경직 연계 후순위")
				score = score + 15
			elseif p.kind == "unknown" or p.kind == "utility" then
				prefer(context.stunned and context.remaining > 0.6 and distance < 65, 30, "남은 스킬로 연결")
			elseif p.kind == "finish" then
				prefer(context.stunned or context.healthRatio <= 0.22, 45, "마무리 우선 조건 아님")
				score = score + (context.healthRatio <= 0.22 and 45 or 0)
			end
			if context.stunned then
				if p.kind == "burst" or p.kind == "charge" or p.kind == "catch" then score = score + 35 end
				if ccRate > 0.2 then score = score + (context.remaining < 0.3 and 35 or -25) end
				if p.charge and context.remaining >= p.charge + 0.22 then hold, role, score = p.charge, "경직 중 차징", score + 35 end
			else
				score = score + ccRate * 55
				if p.kind == "quick" or p.kind == "catch" then score = score + 15 end
			end
			if context.lastSkill == skill.settingId then score = score - 40 end
			local elapsed = context.now - (context.lastUse[skill.settingId] or -100)
			if elapsed < 0.1 then eligible = false; notes[#notes + 1] = "중복 입력 잠깐 대기" end
			diagnostics.skills[skill.settingId] = {eligible = eligible, preferred = preferred, score = score, reason = table.concat(notes, " · ")}
			if eligible and (not highest or score > highest or score == highest and skill.settingId < chosen.settingId) then
				chosen, highest = skill, score
				decision = {
					hold = hold, recovery = p.recovery, channel = p.channel or 0,
					role = preferred and role or ("남은 스킬 연결 · " .. p.label), score = score, fallback = not preferred,
				}
			end
		end
		diagnostics.selected = chosen and chosen.settingId or nil
		return chosen, decision or "사용 조건을 만족하는 스킬 대기", diagnostics
	end

	return M
end)({})
