local function characterReady()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return nil, "부활 대기" end
	if humanoid.Sit then return nil, "앉아 있는 중" end
	if config.comboEnabled and character:FindFirstChild("ChargeFolder") then return nil, "돌진 마무리" end
	if gameG.CheckStunClient(player) then return nil, "기절 중" end
	if gameG.CheckDoingClient(player) or gameG.AntiMobSkill() then return nil, "동작 중" end
	return humanoid
end


local function allowed(skill)
	if config.excluded[skill.settingId] then return false, "제외 설정" end
	if not skill.tool.Parent or skill.tool.Parent ~= player.Backpack and skill.tool.Parent ~= player.Character then return false, "장비 미소지" end
	if gameG.Cooldowns[skill.id] then return false, "쿨다운" end
	local stat = player.PlayerStats:FindFirstChild(skill.family.stat)
	local needed = tonumber(skill.data[skill.key .. "Require"])
	if needed and (not stat or stat.Value < needed) then return false, "요구 능력치 부족" end
	local rules = requirement[skill.tool.Name]
	if type(rules) == "table" and type(rules[skill.key]) == "function" then
		local ok, canUse = pcall(rules[skill.key], player)
		if not ok then return false, "스킬 사용 조건 조회 실패" end
		if not canUse then return false, "게임 스킬 사용 조건" end
	end
	if skill.tool.Name == "OpOp" then
		local room = workspace:FindFirstChild("OpeRoom" .. player.Name)
		if skill.key == "Z" then
			if config.comboEnabled and room then return false, "룸 유지" end
		elseif not room then return false, "룸 필요" end
	end
	return true, "사용 가능"
end

local function candidates(includeBlocked)
	local result, seen = {}, {}
	for _,root in ipairs({player.Backpack, player.Character}) do
		if root then
			for _,tool in ipairs(root:GetChildren()) do
				if tool:IsA("Tool") and not seen[tool.Name] then
					seen[tool.Name] = true
					for _,family in ipairs(families) do
						local source = handler[family.folder]:FindFirstChild(tool.Name .. "_Client")
						local dataSource = RS.Chest.Modules.SkillData[family.data]:FindFirstChild(tool.Name .. "_Data")
						if source and dataSource then
							local ok, module = pcall(require, source)
							local dataOK, data = pcall(require, dataSource)
							if ok and dataOK and type(module) == "table" and type(data) == "table" then
								for key, fn in pairs(module) do
									if type(key) == "string" and key:match("^[A-Z]$") and type(fn) == "function" then
										local skill = {tool = tool, family = family, data = data, module = module, key = key, id = family.prefix .. key, settingId = tool.Name .. "::" .. key}
										if includeBlocked or allowed(skill) then result[#result + 1] = skill end
									end
								end
							end
						end
					end
				end
			end
		end
	end
	return result
end

