local path = "scripts/스킬_자동인식_결투_20261102_12.lua"
local file = assert(io.open(path, "rb"))
local source = file:read("*a")
file:close()
local planner = assert(loadstring(source))({TestPlanner = true})
local checks = 0
local function check(value, message)
	assert(value, message)
	checks = checks + 1
end
local context = {valid = true, distance = 50, maxDistance = 180, aimRange = 1000, allowDash = true,
	stunned = false, remaining = 0, healthRatio = 1, now = 10, lastUse = {}, feedback = {}}
for _, tool in ipairs({"Kioru V2", "OpOp", "DragonClaw", "BarrierBarrier", "Apollos", "새 장비"}) do
	for _, key in ipairs({"Z", "X", "C", "V", "E", "B"}) do
		local profile = planner.Profile(tool, key, false, {cooldown = 8})
		local skill = {settingId = tool .. "::" .. key, profile = profile}
		local chosen = planner.Choose({skill}, context)
		check(chosen == skill, "단독으로 남은 스킬 누락: " .. skill.settingId)
		context.distance = 900
		check(planner.Choose({skill}, context) == skill, "우선 거리 밖 스킬 누락: " .. skill.settingId)
		context.distance = 50
	end
end
check(planner.Profile("새 검", "Z", false, {hints = "Z1HoldAwake"}).kind == "charge", "홀드 단서")
check(planner.Profile("새 열매", "X", false, {hints = "FindNearestTargetMouse"}).kind == "catch", "대상 지정 단서")
local dash = {settingId = "새 격투::X", profile = planner.Profile("새 격투", "X", false, {hints = "Dash"})}
context.allowDash = false
check(planner.Choose({dash}, context) == nil, "돌진 금지 유지")
context.allowDash = true
local room = {settingId = "OpOp::Z", profile = planner.Profile("OpOp", "Z", false, {cooldown = 3})}
local attack = {settingId = "Kioru V2::X", profile = planner.Profile("Kioru V2", "X", false, {cooldown = 7})}
check(planner.Choose({attack, room}, context) == room, "룸 준비 우선")
local d = planner.Duel("me", true, "other", true, "me")
check(d.active and d.ready and d.name == "other", "상호 결투 지정")
for _, args in ipairs({{true, "other", false, "me"}, {true, "other", true, "bystander"}, {true, "", true, "me"}, {true, "me", true, "me"}}) do
	local state = planner.Duel("me", unpack(args))
	check(state.active and not state.ready, "불완전 결투는 대기")
end
check(not planner.Duel("me", false, "other", true, "me").active, "결투 종료")
check(planner.DuelCastBlocked(2, 3, false, true, true), "결투 전 대기 입력 취소")
check(planner.DuelCastBlocked(2, 3, true, false, true), "결투 종료 후 지연 입력 취소")
check(planner.DuelCastBlocked(3, 3, true, true, false), "상대 소실 입력 차단")
check(not planner.DuelCastBlocked(3, 3, true, true, true), "정상 상대 입력 허용")
check(planner.IsCanceled(true, false, 1, 2, nil, false, 0), "중지 후 이전 수동 요청 취소")
check(not planner.CanAdvance({released = true, downAt = 1, callReturned = true, releasedAt = 1.05}, {recovery = 0.2}, 1.3, true, false), "실제 동작 중 대기")
check(planner.CanAdvance({released = true, downAt = 1, callReturned = true, releasedAt = 1.05}, {recovery = 0.2}, 1.3, false, false), "Up 없는 즉시 기술 완료")

local vector = {}
vector.__index = function(v, k)
	if k == "Magnitude" then return math.abs(v.x) end
	if k == "Dot" then return function(a, b) return a.x * b.x end end
end
vector.__sub = function(a, b) return setmetatable({x = a.x - b.x}, vector) end
local function model(name, distance, isPlayer)
	return {Name = name, part = {Position = setmetatable({x = distance}, vector)}, isPlayer = isPlayer}
end
local npc, other, bystander = model("npc", 1), model("other", 80, true), model("bystander", 2, true)
local root = {Position = setmetatable({x = 0}, vector)}
local character = {FindFirstChildOfClass = function() return {Health = 100} end, FindFirstChild = function() return root end}
local me = {Character = character}
local duel = {active = true, ready = true, target = other}
local config = {comboEnabled = true, aimMode = "NPC", aimRange = 1000}
local env = setmetatable({
	player = me, config = config, duelState = duel, comboState = {target = bystander, expires = 100}, busy = true,
	livingPart = function(m) return m and not m.dead and m.part end,
	isNPC = function(m) return not m.isPlayer end,
	Players = {GetPlayerFromCharacter = function(_, m) return m.isPlayer end,
		GetPlayers = function() return {me, {Character = bystander}, {Character = other}} end},
	npcHumanoids = {[{Parent = npc, Health = 100, IsDescendantOf = function() return true end}] = true},
	workspace = {},
}, {__index = _G})
npc.IsA = function() return true end
local validSource = assert(source:match("(local function comboTargetValid.-)\nlocal function sampleCombo"))
local selectSource = assert(source:match("(local function selectAimTarget.-)\nlocal function aimHit"))
local selectTarget = assert(loadstring(validSource .. "\n" .. selectSource .. "\nreturn selectAimTarget"))
setfenv(selectTarget, env)
selectTarget = selectTarget()
check(selectTarget() == other, "결투는 가까운 NPC와 기존 콤보 대상보다 우선")
config.aimMode = "Player"
check(selectTarget() == other, "가까운 관전자보다 결투 상대 우선")
duel.ready = false
check(selectTarget() == nil, "상대 미확인 시 다른 플레이어로 전환 금지")
duel.ready = true
other.dead = true
check(selectTarget() == nil, "사망 시 다른 플레이어로 전환 금지")
other.dead = false
other.part.Position.x = 1001
check(selectTarget() == nil, "거리 밖에서 다른 대상으로 전환 금지")
duel.active = false
env.comboState.target = nil
config.aimMode = "NPC"
check(selectTarget() == npc, "결투 종료 후 원래 NPC 탐색 복귀")
print("스킬 자동 인식·결투 회귀 검사 " .. checks .. "개 통과")
