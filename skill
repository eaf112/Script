	stroke.Color = busy and Color3.fromRGB(245, 211, 132) or Color3.fromRGB(225, 223, 211)
	if seconds then
		task.delay(seconds, function()
			if alive and serial == statusSerial and not busy then displayed = "스킬 사용" caption.Text = "무작위" end
		end)
	end
end

local function release(cast)
	if cast and not cast.released then
		cast.released = true
		if type(cast.skill.module.Deactive) == "function" then pcall(cast.skill.module.Deactive, cast.skill.key) end
	end
end


local comboState = {
	target = nil, expires = 0, epoch = 0, pending = nil, phase = "대상 대기",
	lastSkill = nil, lastUse = {}, feedback = {}, wasStunned = false,
	stunStart = nil, stunDuration = nil, sampled = nil, lastLabel = 0, steps = 0, history = {},
}

local aimTarget, aimPart, aimCell, previousAimCell, aimError, legacyAimCell
local aimDistance, aimScanAt, aimRewrites = nil, 0, 0
local lastAimHit, baseAimHit, baseAimMobile, baseAimLegacy
local mobileWrapper, originalMobile, mouseWrapper, originalMouse
local npcHumanoids = {}
local skillFunctions = RS.Chest.Remotes:FindFirstChild("Functions")
local skillRemote = skillFunctions and skillFunctions:FindFirstChild("SkillAction")
local aimSupported = type(hookmetamethod) == "function" and type(newcclosure) == "function"
	and type(getnamecallmethod) == "function" and type(setnamecallmethod) == "function"
	and skillRemote and skillRemote:IsA("RemoteFunction")
local targetMark = Instance.new("Highlight")
targetMark.Name = "스킬_조준_대상"
targetMark.DepthMode = Enum.HighlightDepthMode.Occluded
targetMark.FillColor = Color3.fromRGB(70, 220, 170)
targetMark.OutlineColor = Color3.fromRGB(200, 255, 235)
targetMark.FillTransparency = 0.85
targetMark.OutlineTransparency = 0.1
targetMark.Enabled = false
targetMark.Parent = workspace

local function restoreAimHit()
	if lastAimHit then
		if gameG.MouseHit == lastAimHit then gameG.MouseHit = baseAimHit end
		if gameG.MouseHitMobile == lastAimHit then gameG.MouseHitMobile = baseAimMobile end
		if _G.pos_skill == lastAimHit then _G.pos_skill = baseAimLegacy end
	end
	lastAimHit = nil
end

local function publishAimHit(hit)
	if not lastAimHit or gameG.MouseHit ~= lastAimHit then baseAimHit = gameG.MouseHit end
	if not lastAimHit or gameG.MouseHitMobile ~= lastAimHit then baseAimMobile = gameG.MouseHitMobile end
	if not lastAimHit or _G.pos_skill ~= lastAimHit then baseAimLegacy = _G.pos_skill end
	gameG.MouseHit, gameG.MouseHitMobile, _G.pos_skill = hit, hit, hit
	lastAimHit = hit
end

local function livingPart(model)
	if not model or not model:IsA("Model") or model == player.Character or not model:IsDescendantOf(workspace) then return nil end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return nil end
	local part = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	return part and part:IsA("BasePart") and part or nil
end

local function isNPC(model)
	if Players:GetPlayerFromCharacter(model) then return false end
	local ancestor = model
	while ancestor and ancestor ~= workspace do
		if ancestor.Name == "AllNPC" or ancestor.Name == "CharacterWorkshop" then return false end
		ancestor = ancestor.Parent
	end
	return true
end

local function clearAimTarget()
	aimTarget, aimPart, aimDistance = nil, nil, nil
	targetMark.Enabled = false
	targetMark.Adornee = nil
	restoreAimHit()
end


local function resetCombo(reason, deferRelease)
	comboState.epoch = comboState.epoch + 1
	comboState.target, comboState.pending, comboState.sampled = nil, nil, nil
	comboState.wasStunned, comboState.stunStart, comboState.stunDuration = false, nil, nil
	comboState.phase = stopped and "즉시 중지" or reason or "대상 대기"
	if activeCast and activeCast.combo then
		local cast = activeCast
		if deferRelease then task.defer(function() release(cast) end) else release(cast) end
	end
end

local function refreshDuel()
	if not alive then return duelState end
	local previousLabel = duelState.label
	local character = player.Character
	local state
	if (not character or character:GetAttribute("SpawnSuccess") ~= true) and duelState.active then
		state = {active = true, name = duelState.name, ready = false, reason = "결투 상대 확인 대기"}
	else
		local friendly = character and character:GetAttribute("FriendlyPVP")
		local name = character and character:GetAttribute("SoloDamage")
		local other = type(name) == "string" and Players:FindFirstChild(name)
		local model = other and other:IsA("Player") and other.Character
		state = ComboPlanner.Duel(player.Name, friendly, name,
			model and model:GetAttribute("FriendlyPVP"), model and model:GetAttribute("SoloDamage"))
		state.target = state.ready and model or nil
	end
	local changedTarget = state.active ~= duelState.active or state.name ~= duelState.name
		or state.ready ~= duelState.ready or state.target ~= duelState.target
	if changedTarget then
		state.epoch = duelState.epoch + 1
		duelState = state
		resetCombo(state.active and state.reason or "결투 종료 · 대상 복귀", true)
		local cast = activeCast
		if cast and not cast.combo then task.defer(function() release(cast) end) end
		clearAimTarget()
		aimScanAt = 0
		paintAimMode()
	else
		state.epoch = duelState.epoch
		duelState = state
	end
	if duelLabel then
		local text = state.active and ((state.name and "결투 상대: @" .. state.name or "결투 상대 지정 대기")
			.. (state.ready and " · 고정" or " · 확인 대기")) or "결투 없음 · 설정한 대상 탐색"
		if text ~= previousLabel then duelLabel:SetText(text) end
		state.label = text
	end
	return state
end

local function comboTargetValid(model, root)
	local part = livingPart(model)
	if not part or not root or (part.Position - root.Position).Magnitude > config.aimRange then return nil end
	if duelState.active then return duelState.ready and model == duelState.target and part or nil end
	local other = Players:GetPlayerFromCharacter(model)
	if config.aimMode == "Player" and not other or config.aimMode == "NPC" and not isNPC(model) then return nil end
	return part
end

local function sampleCombo(now)
	if comboState.target and now > comboState.expires and not busy and not (activeCast and activeCast.combo) then comboState.target = nil end
	local target = comboState.target or aimTarget
	local part = livingPart(target)
	if target ~= comboState.sampled then
		comboState.sampled = target
		comboState.wasStunned, comboState.stunStart, comboState.stunDuration = false, nil, nil
	end
	local stunned = part and target:FindFirstChild("Stun") ~= nil
	if stunned and not comboState.wasStunned then comboState.stunStart = now end
	if not stunned and comboState.wasStunned and comboState.stunStart then
		local duration = now - comboState.stunStart
		if duration > 0.04 then
			comboState.stunDuration = comboState.stunDuration and math.min(comboState.stunDuration, duration) or duration
		end
		comboState.stunStart = nil
	end
	comboState.wasStunned = stunned == true
	local observation = comboState.pending
	if observation then
		local humanoid = observation.target and observation.target:FindFirstChildOfClass("Humanoid")
		if now > observation.expires or not humanoid or not observation.target:IsDescendantOf(workspace) then
			comboState.pending = nil
		else
			local feedback = comboState.feedback[observation.id]
			local cc = observation.target:FindFirstChild("Stun") ~= nil
			if humanoid.Health < observation.health - 0.01 and not observation.hit then
				observation.hit, feedback.hits = true, feedback.hits + 1
			end
			if cc and not observation.wasStunned and not observation.cc then
				observation.cc, feedback.cc = true, feedback.cc + 1
			end
			observation.wasStunned = cc
		end
	end
	if comboLabel and now >= comboState.lastLabel + 0.2 then
		comboState.lastLabel = now
		local name = comboState.target and comboState.target.Name or "대상 없음"
		comboLabel:SetText(string.format("%s · %s · %d회 시전", name, comboState.phase, comboState.steps))
	end
end

local function observeComboAction(args)
	local cast = activeCast
	if not cast or not cast.combo or args[1] ~= cast.remoteId or type(args[2]) ~= "table" then return end
	local now, inputType = os.clock(), args[2].Type
	if inputType == "Down" then
		cast.downAt = now
	elseif inputType == "Up" then
		cast.upAt = now
		if comboState.pending and comboState.pending.id == cast.skill.settingId then comboState.pending.expires = now + 0.9 end
	end
end

local function comboProfile(skill)
	local awake = false
	if skill.tool.Name == "RumbleRumble" and type(gameG.CheckAwakeClient) == "function" then
		local ok, value = pcall(gameG.CheckAwakeClient, player, "Rumble" .. skill.key)
		awake = ok and value == true
	end
	local fn = skill.module[skill.key]
	local cached = comboState.profiles and comboState.profiles[fn]
	if not cached then
		local hints = {}
		if type(getconstants) == "function" then
			local ok, values = pcall(getconstants, fn)
			if ok and type(values) == "table" then
				for _, value in pairs(values) do if type(value) == "string" then hints[#hints + 1] = value end end
			end
		end
		cached = table.concat(hints, " ")
		comboState.profiles = comboState.profiles or {}
		comboState.profiles[fn] = cached
	end
	local cooldown = tonumber(skill.data[skill.key])
	if skill.tool.Parent == player.Character and type(gameG.GetCooldownClient) == "function" then
		local ok, value = pcall(gameG.GetCooldownClient, skill.id)
		if ok and type(value) == "number" and value == value and value >= 0 and value < math.huge then cooldown = value end
	end
	return ComboPlanner.Profile(skill.tool.Name, skill.key, awake, {cooldown = cooldown, hints = cached})
end

local function chooseCombo(list)
	if not config.aimEnabled and not duelState.active then return nil, "사일런트 에임을 켜주세요" end
	local target, part = aimTarget, livingPart(aimTarget)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not part or not root then return nil, "조준 대상 대기" end
	local now = os.clock()
	if comboState.target ~= target then comboState.target, comboState.expires = target, now + 0.25 end
	sampleCombo(now)
	comboState.target = target
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	local remaining = 0
	if comboState.wasStunned then
		remaining = comboState.stunDuration and math.max(0, comboState.stunDuration - (now - (comboState.stunStart or now))) or 0.22
	end
	for _, skill in ipairs(list) do skill.profile = comboProfile(skill) end
	local context = {
		valid = humanoid and humanoid.Health > 0, distance = (part.Position - root.Position).Magnitude,
		maxDistance = config.comboDistance, aimRange = config.aimRange, allowDash = config.comboDash, stunned = comboState.wasStunned,
		remaining = remaining, healthRatio = humanoid and humanoid.Health / math.max(1, humanoid.MaxHealth) or 1,
		now = now, lastSkill = comboState.lastSkill, lastUse = comboState.lastUse, feedback = comboState.feedback,
	}
	local skill, decision, diagnostics = ComboPlanner.Choose(list, context)
	comboState.selection = diagnostics
	return skill, decision
end

local function selectAimTarget()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not humanoid or humanoid.Health <= 0 then return nil end
	if duelState.active then
		local model = duelState.ready and duelState.target
		local part = model and comboTargetValid(model, root)
		if part then return model, part, (part.Position - root.Position).Magnitude end
		return nil
	end
	if config.comboEnabled and comboState.target and (busy or os.clock() < comboState.expires) then
		local pinned = comboTargetValid(comboState.target, root)
		if pinned then return comboState.target, pinned, (pinned.Position - root.Position).Magnitude end
	end
	local closest, part, distance = nil, nil, config.aimRange * config.aimRange
	local function consider(model)
		local candidate = livingPart(model)
		if not candidate then return end
		local delta = candidate.Position - root.Position
		local squared = delta:Dot(delta)
		if squared < distance then closest, part, distance = model, candidate, squared end
	end
	if config.aimMode == "Player" then
		for _, other in ipairs(Players:GetPlayers()) do if other ~= player then consider(other.Character) end end
	else
		for humanoid in pairs(npcHumanoids) do
			local model = humanoid.Parent
			if not model or not humanoid:IsDescendantOf(workspace) then npcHumanoids[humanoid] = nil
			elseif humanoid.Health > 0 and model:IsA("Model") and isNPC(model) then consider(model) end
		end
	end
	return closest, part, closest and math.sqrt(distance) or nil
end

local function aimHit()
	refreshDuel()
	if not alive or stopped or not (config.aimEnabled or duelState.active) or not aimCell or aimCell.Owner ~= api then return nil end
	local part = livingPart(aimTarget)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not part or part ~= aimPart or not root or not humanoid or humanoid.Health <= 0 then return nil end
	local targetPlayer = Players:GetPlayerFromCharacter(aimTarget)
	if duelState.active then
		if not duelState.ready or aimTarget ~= duelState.target then return nil end
	elseif config.aimMode == "Player" and not targetPlayer or config.aimMode == "NPC" and not isNPC(aimTarget) then return nil end
	if (part.Position - root.Position).Magnitude > config.aimRange then return nil end
	local position, velocity = part.Position, part.AssemblyLinearVelocity
	if velocity.Magnitude == velocity.Magnitude and velocity.Magnitude < 1000 then position = position + velocity * 0.12 end
	return CFrame.new(position)
end

local function rewriteAim(args, preview)
	local hit = aimHit()
	local cast = activeCast
	if cast and args[1] == cast.remoteId and ComboPlanner.DuelCastBlocked(cast.duelEpoch, duelState.epoch, cast.duelProtected, duelState.active, hit ~= nil) then
		if not preview then cast.blocked = "결투 대상 변경 · 공격 대기" end
		return nil, true
	end
	if not preview then observeComboAction(args) end
	if not hit then return nil end
	local name, payload = args[1], args[2]
	if type(name) ~= "string" or type(payload) ~= "table" or name:sub(3, 3) ~= "_" then return nil end
	local family = name:sub(1, 2)
	if family ~= "DF" and family ~= "SW" and family ~= "FS" then return nil end
	local value = payload.MouseHit
	if typeof(value) ~= "CFrame" and typeof(value) ~= "Vector3" then return nil end
	local copied = {}
	for key, item in pairs(payload) do copied[key] = item end
	copied.MouseHit = typeof(value) == "Vector3" and hit.Position or hit
	args[2] = copied
	if not preview then aimRewrites = aimRewrites + 1 end
	return args
end

local function installAim()
	if aimCell and aimCell.Owner == api then return true end
	if not aimSupported then return false, "이 실행기에서 SkillAction 조준 보정을 지원하지 않습니다" end
	local hookKey = "KL_BOUNTY_SILENT_AIM_ONLY_V2_HOOK_CELL"
	aimCell = env[hookKey]
	if type(aimCell) ~= "table" or aimCell.Version ~= 2 then
		aimCell = {Version = 2}
		local relay = aimCell
		local predecessor
		predecessor = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
			local callback = relay.Handler
			local method = callback and self == relay.Remote and getnamecallmethod()
			if method == "InvokeServer" then
				local ok, changed, blocked = pcall(callback, table.pack(...))
				setnamecallmethod(method)
				if ok and blocked then return nil end
				if ok and changed then return predecessor(self, table.unpack(changed, 1, changed.n)) end
			end
			return predecessor(self, ...)
		end))
		env[hookKey] = aimCell
	end
	previousAimCell = {Owner = aimCell.Owner, Remote = aimCell.Remote, Handler = aimCell.Handler}
	aimCell.Owner, aimCell.Remote, aimCell.Handler = api, skillRemote, rewriteAim
	local legacy = env.KL_BOUNTY_SILENT_AIM_ONLY_V1_HOOK_CELL
	if type(legacy) == "table" and legacy.Handler then
		legacyAimCell = {cell = legacy, Owner = legacy.Owner, Remote = legacy.Remote, Handler = legacy.Handler}
		legacy.Owner, legacy.Handler = api, nil
	end
	if type(gameG.GetMouse) == "function" then
		originalMouse = gameG.GetMouse
		local fallback = originalMouse
		mouseWrapper = function(...)
			local hit = aimHit()
			if hit then return hit end
			return fallback(...)
		end
		gameG.GetMouse = mouseWrapper
	end
	if type(gameG.MouseHitMobileUpdate) == "function" then
		originalMobile = gameG.MouseHitMobileUpdate
		local fallback = originalMobile
		mobileWrapper = function(...)
			if lastAimHit and gameG.MouseHitMobile == lastAimHit then gameG.MouseHitMobile = baseAimMobile end
			local values = table.pack(fallback(...))
			local hit = aimHit()
			if hit then publishAimHit(hit) else restoreAimHit() end
			return table.unpack(values, 1, values.n)
		end
		gameG.MouseHitMobileUpdate = mobileWrapper
	end
	return true
end

local function detachAim()
	if aimCell and aimCell.Owner == api then
		local previous = previousAimCell or {}
		aimCell.Owner, aimCell.Remote, aimCell.Handler = previous.Owner, previous.Remote, previous.Handler
	end
	if legacyAimCell and legacyAimCell.cell.Owner == api then
		local previous, cell = legacyAimCell, legacyAimCell.cell
		cell.Owner, cell.Remote, cell.Handler = previous.Owner, previous.Remote, previous.Handler
	end
	if mouseWrapper and gameG.GetMouse == mouseWrapper then gameG.GetMouse = originalMouse end
	if mobileWrapper and gameG.MouseHitMobileUpdate == mobileWrapper then gameG.MouseHitMobileUpdate = originalMobile end
	clearAimTarget()
	targetMark:Destroy()
end

local function updateAim(now)
	refreshDuel()
	if stopped or not (config.aimEnabled or duelState.active) then return end
	if duelState.active and (not aimCell or aimCell.Owner ~= api) then
		local ok, installed, reason = pcall(installAim)
		if not ok or not installed then aimError = tostring(ok and reason or installed); clearAimTarget(); return end
	end
	if now >= aimScanAt then
		aimScanAt = now + 0.15
		aimTarget, aimPart, aimDistance = selectAimTarget()
		if targetLabel then
			local other = aimTarget and Players:GetPlayerFromCharacter(aimTarget)
			local name = other and ("@" .. other.Name) or aimTarget and aimTarget.Name
			targetLabel:SetText(name and string.format("현재 대상: %s · %.0f스터드", name, aimDistance) or "현재 대상 없음")
		end
	end
	local hit = aimHit()
	if hit then
		publishAimHit(hit)
		targetMark.Adornee, targetMark.Enabled = aimTarget, true
	else
		clearAimTarget()
	end
end

local function saveMessage(message)
	if saveLabel and window and window.Alive then saveLabel:SetText(message) end
end

local function saveNow()
	if not dirty then return saveError == nil end
	env[settingsKey] = config
	if type(writefile) ~= "function" or type(readfile) ~= "function" then
		saveError = "설정 파일 읽기·쓰기를 지원하지 않습니다"
		saveMessage("이번 실행에서만 유지 · " .. saveError)
		return false
	end
	local ok, reason = pcall(function()
		local encoded = HttpService:JSONEncode(config)
		writefile(settingsFile, encoded)
		assert(readfile(settingsFile) == encoded, "저장한 설정의 내용이 일치하지 않습니다")
	end)
	if not ok then
		saveError = tostring(reason)
		saveMessage("저장 실패 · " .. saveError)
		warn("스킬 버튼 설정 저장 실패: " .. saveError)
		return false
	end
	dirty, saveError = false, nil
	saveMessage("설정 저장됨")
	return true
end

local function changed()
	dirty = true
	env[settingsKey] = config
	saveSerial = saveSerial + 1
	local serial = saveSerial
	saveMessage("설정 저장 대기")
	task.delay(0.35, function()
		if alive and serial == saveSerial then saveNow() end
	end)
end


function api:SetAim(enabled, mode, range)
	if not alive then return false end
	resetCombo("대상 변경")
	if enabled then
		local ok, installed, reason = pcall(installAim)
		if not ok or not installed then
			aimError = tostring(ok and reason or installed)
			config.aimEnabled = false
			clearAimTarget()
			if aimControl then aimControl:Set(false, true) end
			if targetLabel then targetLabel:SetText("조준 보정 오류 · " .. aimError) end
			return false, aimError
		end
	end
	config.aimEnabled = enabled == true
	if mode == "Player" or mode == "NPC" then config.aimMode = mode end
	local number = tonumber(range)
	if number and number == number and math.abs(number) < math.huge then config.aimRange = math.clamp(number, 50, 3000) end
	aimError, aimScanAt = nil, 0
	clearAimTarget()
	if aimControl then aimControl:Set(config.aimEnabled, true) end
	if aimModeControl then aimModeControl:Set(config.aimMode, true) end
	if aimRangeControl then aimRangeControl:Set(config.aimRange, true) end
	if targetLabel then targetLabel:SetText(stopped and "즉시 중지 · 중지 해제 후 다시 사용" or config.aimEnabled and "현재 대상 확인 중" or "사일런트 에임 꺼짐") end
	paintAimMode()
	if config.aimEnabled then updateAim(os.clock()) end
	changed()
	return true
end

function api:ToggleAimMode()
	local mode = config.aimMode == "Player" and "NPC" or "Player"
	return self:SetAim(config.aimEnabled, mode)
end

function api:SetCombo(enabled, distance, allowDash)
	if not alive then return false end
	config.comboEnabled = enabled == true
	local number = tonumber(distance)
	if number and number == number and math.abs(number) < math.huge then config.comboDistance = math.clamp(number, 25, 300) end
	if type(allowDash) == "boolean" then config.comboDash = allowDash end
	resetCombo(config.comboEnabled and "연계 대기" or "무작위 사용")
	title.Text = config.comboEnabled and "연계" or "스킬"
	if not busy and not stopped then caption.Text = config.comboEnabled and "콤보" or "무작위" end
	if comboControl then comboControl:Set(config.comboEnabled, true) end
	if comboDistanceControl then comboDistanceControl:Set(config.comboDistance, true) end
	if comboDashControl then comboDashControl:Set(config.comboDash, true) end
	if config.comboEnabled and not config.aimEnabled then self:SetAim(true) end
	changed()
	return true
end

function api:GetComboStatus()
	local feedback = {}
	for id, value in pairs(comboState.feedback) do feedback[id] = {attempts = value.attempts, hits = value.hits, cc = value.cc} end
	return {enabled = config.comboEnabled, phase = comboState.phase, target = comboState.target and comboState.target.Name,
		steps = comboState.steps, distance = config.comboDistance, allowDash = config.comboDash,
		stunned = comboState.wasStunned, observedStunDuration = comboState.stunDuration, feedback = feedback, history = comboState.history}
end

function api:PreviewCombo()
	local skill, decision = chooseCombo(candidates())
	return skill and {id = skill.settingId, hold = decision.hold, recovery = decision.recovery, role = decision.role} or {waiting = decision}
end

function api:GetAimStatus()
	return {
		enabled = config.aimEnabled, paused = stopped, mode = config.aimMode, range = config.aimRange,
		effectiveMode = duelState.active and "Duel" or config.aimMode,
		duel = {active = duelState.active, ready = duelState.ready, opponent = duelState.name, epoch = duelState.epoch},
		target = aimTarget and aimTarget.Name, path = aimTarget and aimTarget:GetFullName(),
		distance = aimDistance, isPlayer = aimTarget and Players:GetPlayerFromCharacter(aimTarget) ~= nil,
		hookOwned = aimCell and aimCell.Owner == self or false, rewrites = aimRewrites, error = aimError,
	}
end

local function applyPosition()
	local x, y = config.x / 100, config.y / 100
	button.Position = UDim2.new(x, (0.5 - x) * 72, y, (0.5 - y) * 72)
	layoutAutoButton()
end

function api:SetPosition(x, y)
	if not alive then return false end
	config.x, config.y = percent(x, config.x), percent(y, config.y)
	applyPosition()
	if xControl then xControl:Set(config.x, true) end
	if yControl then yControl:Set(config.y, true) end
	changed()
	return true
end

local function selection()
	local values = {}
	for id in pairs(config.excluded) do values[#values + 1] = id end
	table.sort(values)
	return values
end

function api:SetExcluded(values)
	if not alive or type(values) ~= "table" then return false end
	local excluded = {}
	for _, id in ipairs(values) do
		if type(id) == "string" and id:match("^.+::[A-Z]$") then excluded[id] = true end
	end
	config.excluded = excluded
	if excludedControl then excludedControl:Set(selection(), true) end
	changed()
	return true
end

function api:GetSettings()
	return {x = config.x, y = config.y, excluded = selection(), aimEnabled = config.aimEnabled, aimMode = config.aimMode, aimRange = config.aimRange, comboEnabled = config.comboEnabled, comboDistance = config.comboDistance, comboDash = config.comboDash, file = settingsFile, saveError = saveError}
end

function api:GetSkillDiagnostics()
	local list = {}
	local _, casterReason = characterReady()
	for _, skill in ipairs(candidates(true)) do
		local available, reason = allowed(skill)
		local strategy = comboState.selection and comboState.selection.skills[skill.settingId]
		local profile = comboProfile(skill)
		list[#list + 1] = {
			id = skill.settingId, name = skill.tool.Name .. " · " .. skill.key, available = available,
			reason = available and (stopped and "즉시 중지 상태" or casterReason or "사용 가능") or reason,
			priority = strategy and strategy.reason or nil,
			selected = comboState.selection and comboState.selection.selected == skill.settingId or false,
			profile = {kind = profile.kind, role = profile.label, source = profile.source, cooldown = profile.cooldown},
		}
	end
	table.sort(list, function(a, b) return a.id < b.id end)
	return list
end

function api:GetSkills(availableOnly)
	local list = {}
	for _, skill in ipairs(candidates(not availableOnly)) do
		list[#list + 1] = {id = skill.settingId, name = skill.tool.Name .. " · " .. skill.key, excluded = config.excluded[skill.settingId] == true}
	end
	table.sort(list, function(a, b) return a.id < b.id end)
	return list
end

local function refreshOptions()
	if not alive or not excludedControl then return end
	local choices, seen = {}, {}
	for _, skill in ipairs(api:GetSkills(false)) do
		choices[#choices + 1] = {Value = skill.id, Label = skill.name}
		seen[skill.id] = true
	end
	for _, id in ipairs(selection()) do
		if not seen[id] then choices[#choices + 1] = {Value = id, Label = id:gsub("::", " · ") .. " (미소지)"} end
	end
	table.sort(choices, function(a, b) return a.Value < b.Value end)
	excludedControl:SetOptions(choices, true)
	excludedControl:Set(selection(), true)
end



function api:StopNow()
	if not alive then return false end
	stopped, stopEpoch = true, stopEpoch + 1
	autoEnabled, autoEpoch = false, autoEpoch + 1
	nextAuto = math.huge
	if autoControl then autoControl:Set(false, true) end
	autoButton.Text = "자동 꺼짐"
	autoButton.TextColor3 = Color3.fromRGB(225, 223, 211)
	autoStroke.Color = Color3.fromRGB(125, 128, 122)
	local cast = activeCast
	resetCombo("즉시 중지", true)
	if cast and not cast.combo then task.defer(function() release(cast) end) end
	clearAimTarget()
	if targetLabel then targetLabel:SetText("즉시 중지 · 중지 해제 후 다시 사용") end
	if comboLabel then comboLabel:SetText("즉시 중지 · 새 시전 대기 요청 취소됨") end
	paintStop()
	show("중지됨")
	return true
end

function api:Resume()
	if not alive then return false end
	stopped = false
	paintStop()
	show("스킬 사용")
	comboState.phase = "연계 대기"
	aimScanAt = 0
	if config.aimEnabled then updateAim(os.clock()) end
	return true
end

function api:SetAuto(enabled)
	if not alive then return false end
	enabled = enabled == true
	if enabled and stopped then self:Resume() end
	if autoEnabled == enabled then return true end
	autoEnabled = enabled
	autoEpoch = autoEpoch + 1
	nextAuto = 0
	if autoControl then autoControl:Set(enabled, true) end
	autoButton.Text = enabled and "자동 켜짐" or "자동 꺼짐"
	autoButton.TextColor3 = enabled and Color3.fromRGB(150, 255, 175) or Color3.fromRGB(225, 223, 211)
	autoStroke.Color = enabled and Color3.fromRGB(100, 225, 135) or Color3.fromRGB(125, 128, 122)
	if not enabled then resetCombo("자동 사용 중단") end
	if not enabled and activeCast and activeCast.automatic then
		local cast = activeCast
		task.defer(function() release(cast) end)
	end
	return true
end

function api:ToggleAuto()
	return self:SetAuto(not autoEnabled)
end

function api:UseRandom(autoToken)
	refreshDuel()
	local duelEpoch = duelState.epoch
	local requestEpoch = stopEpoch
	local function canceled()
		refreshDuel()
		return duelEpoch ~= duelState.epoch or ComboPlanner.IsCanceled(alive, stopped, requestEpoch, stopEpoch, autoToken, autoEnabled, autoEpoch)
	end
	if canceled() then return false, stopped and "즉시 중지 상태" or "자동 사용 중단" end
	if not alive or busy then return false, "시전 중" end
	updateAim(os.clock())
	if duelState.active and not aimHit() then
		local reason = duelState.ready and "결투 상대 거리·조준 확인 대기" or "결투 상대 확인 대기"
		show(reason, 0.4)
		return false, reason
	end
	local humanoid, reason = characterReady()
	if not humanoid then show(reason, 0.7) return false, reason end
	local list = candidates()
	if #list == 0 then show("사용 가능 없음", 0.9) return false, "사용 가능 없음" end
	if canceled() then return false, "자동 사용 중단" end
	if busy then return false, "시전 중" end
	local useCombo = config.comboEnabled
	local skill, decision
	if useCombo then
		skill, decision = chooseCombo(list)
		if not skill then comboState.phase = decision; show(decision, 0.4); return false, decision end
	else
		skill = list[random:NextInteger(1, #list)]
	end
	local comboEpoch = comboState.epoch
	local attempted = false
	local blockedReason
	busy = true
	show("장비 준비")
	local ok, err = pcall(function()
		if canceled() then blockedReason = "자동 사용 중단"; return end
		if skill.tool.Parent ~= player.Character then
			humanoid:EquipTool(skill.tool)
			task.wait(0.05)
		end
		if canceled() or useCombo and comboEpoch ~= comboState.epoch then blockedReason = "연계 중단"; return end
		local current, blocked = characterReady()
		if current ~= humanoid or not allowed(skill) or skill.tool.Parent ~= player.Character then
			blockedReason = blocked or "다시 눌러주세요"
			show(blockedReason, 0.8)
			return
		end
		if canceled() or useCombo and comboEpoch ~= comboState.epoch then blockedReason = "연계 중단"; return end
		if duelState.active and not aimHit() then blockedReason = "결투 상대 확인 대기"; return end
		if useCombo then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			local pinned = comboTargetValid(comboState.target, root)
			if not pinned or (pinned.Position - root.Position).Magnitude > config.aimRange then blockedReason = "조준 대상 거리 변경"; return end
		end
		lastSkill = skill.tool.Name .. " " .. skill.key
		show(lastSkill)
		local cast = {
			skill = skill, released = false, automatic = autoToken ~= nil, combo = useCombo,
			duelEpoch = duelEpoch, duelProtected = duelState.active,
			remoteId = skill.family.prefix .. "_" .. skill.tool.Name .. "_" .. skill.key, started = os.clock(),
		}
		activeCast = cast
		if useCombo then
			comboState.phase, comboState.lastSkill = decision.role, skill.settingId
			comboState.lastUse[skill.settingId] = cast.started
			comboState.expires = cast.started + decision.hold + decision.channel + 3.5
			local feedback = comboState.feedback[skill.settingId] or {attempts = 0, hits = 0, cc = 0}
			comboState.feedback[skill.settingId] = feedback
			feedback.attempts = feedback.attempts + 1
			local humanoid = comboState.target:FindFirstChildOfClass("Humanoid")
			comboState.pending = {id = skill.settingId, target = comboState.target, health = humanoid.Health,
				wasStunned = comboState.target:FindFirstChild("Stun") ~= nil, expires = cast.started + decision.hold + decision.channel + 2}
		end
		local hold = useCombo and decision.hold or 0.04
		if useCombo then
			task.spawn(function()
				while alive and not cast.released and not canceled() and comboEpoch == comboState.epoch do
					local now = os.clock()
					if ComboPlanner.HoldReady(cast, hold, now) then break end
					task.wait()
				end
				if not cast.released then cast.releasedAt = os.clock(); release(cast) end
			end)
		else
			task.delay(hold, function() release(cast) end)
		end
		task.delay(10, function()
			if alive and busy and activeCast == cast then show("응답 대기 중") end
		end)
		attempted = true
		if autoToken ~= nil then autoCastCount = autoCastCount + 1 end
		skill.module[skill.key]()
		cast.callReturned = true
		if cast.blocked then attempted = false; blockedReason = cast.blocked end
		if useCombo then
			local deadline = cast.started + decision.hold + decision.channel + 2
			while alive and not canceled() and comboEpoch == comboState.epoch and os.clock() < deadline do
				local charging = player.Character and player.Character:FindFirstChild("ChargeFolder") ~= nil
				if ComboPlanner.CanAdvance(cast, decision, os.clock(), gameG.CheckDoingClient(player), charging) then break end
				task.wait()
			end
			release(cast)
			if cast.upAt or cast.downAt and cast.callReturned and not cast.blocked then
				comboState.steps = comboState.steps + 1
				comboState.history[#comboState.history + 1] = {
					id = skill.settingId, role = decision.role, requestedHold = decision.hold,
					observedHold = cast.downAt and cast.releasedAt and cast.releasedAt - cast.downAt or nil,
					upObserved = cast.upAt ~= nil,
				}
				if #comboState.history > 8 then table.remove(comboState.history, 1) end
			end
		else
			release(cast)
		end
		if activeCast == cast then activeCast = nil end
	end)
	busy = false
	if not alive then return ok, err end
	if not ok then
		release(activeCast)
		activeCast = nil
		warn("스킬 사용 오류: " .. tostring(err))
		show("스킬 오류", 1)
		return false, tostring(err)
	end
	show(displayed, 0.8)
	return attempted, attempted and lastSkill or blockedReason
end

function api:GetStatus()
	return {alive = alive, stopped = stopped, busy = busy, lastSkill = lastSkill, autoEnabled = autoEnabled, autoQueued = autoQueued, autoCastCount = autoCastCount, aim = self:GetAimStatus(), combo = self:GetComboStatus(), fixed = true, layoutMode = "설정한 위치에 고정", settings = self:GetSettings(), position = {x = button.AbsolutePosition.X, y = button.AbsolutePosition.Y}, size = button.AbsoluteSize.X}
end

function api:Destroy()
	if not alive then return end
	if dirty then saveNow() end
	autoEnabled, autoEpoch = false, autoEpoch + 1
	stopped, stopEpoch = true, stopEpoch + 1
	alive = false
	detachAim()
	release(activeCast)
	for _,connection in ipairs(connections) do connection:Disconnect() end
	for _,connection in ipairs(characterConnections) do connection:Disconnect() end
	if window and window.Alive then window:Destroy() end
	gui:Destroy()
	if env[key] == api then env[key] = nil end
end
