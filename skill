local function watchCharacter(character)
	for _, connection in ipairs(characterConnections) do connection:Disconnect() end
	characterConnections = {}
	if character then
		characterConnections[#characterConnections + 1] = character.ChildAdded:Connect(toolChanged)
		characterConnections[#characterConnections + 1] = character.ChildRemoved:Connect(toolChanged)
	end
end
