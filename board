factories.core = (function()
return function()
	local Core = {}
	local ignored = {action = true, serverTime = true, now = true, remaining = true}
	function Core.fingerprint(value)
		local budget, seen = 10000, {}
		local function encode(v, depth)
			local kind = type(v)
			if kind ~= "table" then
				if kind == "number" then return "n" .. string.format("%.12g", v) end
				if kind == "string" then return "s" .. #v .. ":" .. v end
				return kind .. ":" .. tostring(v)
			end
			if depth > 14 or seen[v] then error("상태 구조가 지원 범위를 벗어났어요") end
			seen[v] = true
			local keys, parts = {}, {"{"}
			for k in pairs(v) do
				if not ignored[k] then keys[#keys + 1] = k end
			end
			table.sort(keys, function(a, b) return type(a) .. tostring(a) < type(b) .. tostring(b) end)
			for _, k in ipairs(keys) do
				budget = budget - 1
				if budget < 0 then error("상태가 너무 커서 자동 조작을 중지했어요") end
				parts[#parts + 1] = encode(k, depth + 1) .. "=" .. encode(v[k], depth + 1) .. ";"
			end
			parts[#parts + 1] = "}"
			seen[v] = nil
			return table.concat(parts)
		end
		return encode(value, 0)
	end
	function Core.new()
		return {state = nil, memory = {}, sent = {}, queue = {}, enabled = true,
			lastSent = -math.huge, received = 0, count = 0, errors = 0, epoch = 0}
	end
	function Core.accept(c, s, clock)
		if type(s) ~= "table" or not s.room then return false end
		if not s.mySeat then
			if c.state and c.state.room == s.room then
				c.state, c.memory, c.sent, c.queue = nil, {}, {}, {}
				c.epoch = c.epoch + 1
			end
			return false
		end
		local previous = c.state
		local oldGame = previous and previous.game
		local newGame = s.game
		local restart = not previous or previous.room ~= s.room or previous.gameId ~= s.gameId
			or previous.mySeat ~= s.mySeat
			or (previous.phase ~= "playing" and s.phase == "playing")
			or (oldGame and newGame and oldGame.gameKey ~= newGame.gameKey)
		if restart then
			c.memory, c.sent, c.queue = {}, {}, {}
			c.epoch = c.epoch + 1
		end
		local signature = Core.fingerprint({room = s.room, mySeat = s.mySeat,
			gameId = s.gameId, phase = s.phase, game = s.game, my = s.my})
		c.received = clock
		if not restart and c.signature == signature and c.state then
			c.state.action = s.action
			return true
		end
		c.state, c.signature = s, signature
		return true
	end
	function Core.hasSent(c)
		return c.signature and c.sent[c.epoch .. ":" .. c.signature] == true
	end
	function Core.reserve(c, s, plan, clock, interval)
		if not c.enabled or c.state ~= s or not plan or clock - c.lastSent < interval then return false end
		local key = c.epoch .. ":" .. c.signature
		if c.sent[key] then return false end
		c.sent[key] = true
		c.queue[#c.queue + 1] = key
		if #c.queue > 512 then c.sent[table.remove(c.queue, 1)] = nil end
		c.lastSent, c.count = clock, c.count + 1
		return true
	end
	return Core
end

end)()
