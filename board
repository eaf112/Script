		if clock - c.received > 20 then setStatus("새 서버 상태를 기다리는 중", "상태 다시 받기 버튼으로 현재 상태를 요청할 수 있어요") return end
		if not s.mySeat then return end
		thinking = true
		local serial, signature, memory = generation, c.signature, c.memory
		task.spawn(function()
			local ok, decision
			if cached and cached.state == s and cached.generation == serial then
				ok, decision = true, cached.decision
			else
				ok, decision = pcall(plan, s, memory, workspace:GetServerTimeNow())
			end
			thinking = false
			if not alive or generation ~= serial or c.state ~= s or c.signature ~= signature then return end
			if not ok then c.errors = c.errors + 1 pause("판단 중 오류: " .. tostring(decision)) return end
			if not decision then return end
			if decision.action ~= "Pull" and decision.action ~= "React" then
				cached = {state = s, generation = serial, decision = decision}
			end
			local ready, remaining = human.ready(s, decision, os.clock(), workspace:GetServerTimeNow(), options, c.epoch)
			if not ready then
				setStatus((names[s.gameId] or "게임") .. " 생각하는 중", string.format("다음 행동까지 약 %.1f초", remaining))
				return
			end
			if Core.reserve(c, s, decision, os.clock(), interval) then
				local sent, err = pcall(function()
					local unpack = table.unpack or unpack
					if decision.channel == "lobby" then
						remote:FireServer(decision.action)
					else
						remote:FireServer("Game", decision.action, unpack(decision.args, 1, decision.args.n))
					end
				end)
				if not sent then pause("전송 결과가 불확실해 중지했어요: " .. tostring(err)) return end
				setStatus((names[s.gameId] or "게임") .. " 자동 플레이", (actionNames[decision.action] or "게임 행동") .. " 전송 · 서버 반영 대기")
			end
		end)
	end
	local built, buildError = pcall(function()
