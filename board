		control:Slider({Id = "interval", Text = "행동 사이 최소 간격", Min = 0.15, Max = 1.5, Step = 0.05,
			Default = options.interval, Persist = false, Callback = function(value) options.interval = value end})
		control:Slider({Id = "chessDepth", Text = "체스 탐색 깊이", Min = 1, Max = 4, Step = 1,
