		control:Toggle({Id = "autoStart", Text = "방장일 때 대기실 자동 시작", Default = false, Persist = false,
			Callback = function(value) options.autoStart = value end})
		local natural = main:Section({Title = "사람처럼 플레이"})
		natural:Toggle({Id = "human", Text = "자연스러운 생각·반응 시간", Default = true, Persist = false,
			Callback = function(value) options.human = value human.reset() generation = generation + 1 end})
		natural:Slider({Id = "tempo", Text = "생각하는 시간 배율", Description = "높일수록 천천히 판단해요",
			Min = 0.6, Max = 1.8, Step = 0.1, Default = 1, Persist = false,
			Callback = function(value) options.tempo = value human.reset() generation = generation + 1 end})
		natural:Toggle({Id = "hesitate", Text = "가끔 한 번 더 생각하기", Default = true, Persist = false,
			Callback = function(value) options.hesitate = value human.reset() generation = generation + 1 end})
		natural:Paragraph({Text = "게임에 맞는 행동 속도", Content = "체스·오목·추리는 조금 더 생각하고, 종·망치·폭탄은 빠르게 반응해요. 행동마다 기다리는 시간이 달라져요. 남은 시간이 적으면 대기를 줄이며, 움직이는 게이지는 현재 위치를 다시 확인해요."})
		control:Button({Id = "stop", Text = "자동 플레이 완전 종료", ActionText = "종료", Style = "Danger", Callback = stop})
		local info = main:Section({Title = "사용 방법"})
		info:Paragraph({Text = "의자에 앉고 원하는 게임을 선택하세요", Content = "진행 게임을 자동으로 감지해요. 승패는 게임 규칙과 상대 행동에 따라 달라져요. 수도 맞히기는 내장 사전과 공개된 정답을 사용하며, 모르는 문제는 넘겨요. 알리바이는 근거가 모였을 때 최종 지목해요."})
		local games = window:Tab({Id = "games", Title = "게임별 설정"})
		local section = games:Section({Title = "게임별 자동 플레이"})
		for _, spec in ipairs(deps.catalog) do
			local id = spec.id
			section:Toggle({Id = "game_" .. id, Text = spec.Name, Default = true, Persist = false,
				Callback = function(value) options.games[id] = value human.reset() generation = generation + 1 end})
		end
		window:OnDestroy(stop)
	end)
	if not built then stop() error("자동 플레이 창 생성 실패: " .. tostring(buildError)) end
	connections[#connections + 1] = RunService.Heartbeat:Connect(function(dt)
		accumulator = accumulator + dt
		if accumulator >= 0.05 then accumulator = 0 tick() end
	end)
	local helloOk, helloError = pcall(function() remote:FireServer("Hello") end)
	if not helloOk then pause("현재 상태 요청 실패: " .. tostring(helloError)) end
	api.Window = window
	return api
end

