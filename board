		if epoch ~= gameEpoch then pending, epoch = nil, gameEpoch end
		if not config.human then pending = nil return true, 0 end
		local finish = H.deadline(s)
		if finish and serverNow >= finish then return false, 0 end
		local key = context(s, decision)
		if not pending or pending.key ~= key then
			local name, delay = decision.action
			if fast[name] then
				delay = sample(0.23, 0.62)
			elseif s.gameId == "BombTrial" then delay = sample(0.25, 0.7)
			elseif small[name] then delay = sample(0.3, 0.85)
			elseif board[s.gameId] then delay = sample(1.2, 3.8)
			elseif name == "Answer" then
				local answer = decision.args and decision.args[1]
				delay = sample(0.8, 1.7) + math.min(1.4, #(tostring(answer or "")) * 0.035)
			else delay = sample(0.6, 1.9) end
