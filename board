	end
	local function context(s, decision)
		local g = s.game or {}
		local key = {room = s.room, game = s.gameId, seat = s.mySeat, phase = s.phase,
			step = g.phase, round = g.round, turn = g.turn, count = g.turnCount,
			finish = g.phaseEndsAt, turnEnd = g.turnEndsAt, cue = g.cueAt,
			pullStart = g.pullStart, tugs = g.tugs, num = g.num, rolls = g.rolls,
			action = decision.action}
		if decision.action ~= "React" and decision.action ~= "Pull" then key.args = decision.args end
		if decision.action == "Bell" or decision.action == "Claim" then
			key.center, key.ring, key.board = g.center, g.ring, g.board
			key.tops = {}
			for seat, info in pairs(g.seats or {}) do
				if type(info) == "table" then
