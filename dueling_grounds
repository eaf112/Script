	local function publish()
		for fn in pairs(listeners) do pcall(fn, M) end
	end
	local function status(state, message)
		if M.state ~= state or M.message ~= message then M.state, M.message = state, message publish() end
	end
	local function wake() nextStep = 0 end
	function M:Subscribe(fn)
		listeners[fn] = true fn(self)
		return function() listeners[fn] = nil end
	end
	function M:Configure(options)
		for _, name in ipairs({"mode", "map", "weapon", "delay"}) do
			if options[name] ~= nil and self.options[name] ~= options[name] then
				self.options[name] = options[name]
				if name == "map" then mapChoice, pending.Map = nil, nil end
				if name == "weapon" then weaponChoice, pending.Weapon = nil, nil end
			end
		end
		wake()
	end
	function M:SetEnabled(value)
		local enabled = value == true
		self.initialized = true
		if enabled and self.failedTeleport then
			self.enabled = false
			status("ERROR", "서버 이동 실패 후에는 스크립트를 다시 실행하세요") publish()
			return false
		end
		if enabled and not env.teleport.supported then
			self.enabled = false
			status("ERROR", "현재 실행기는 서버 이동 이어하기를 지원하지 않습니다")
			publish()
			return false
		end
		if self.enabled == enabled then return enabled end
		self.enabled = enabled
		if enabled then
			env.teleport:SetEnabled(true)
			status("WAIT", "매치 상태 확인")
		else
			status("OFF", "오토팜 중지")
		end
		publish() wake()
		return enabled
	end
	function M:WeaponOptions()
		local names, values = {}, {{Value = "Auto", Label = "자동 선택"}}
		for name in pairs(env.catalog.weapons) do if env.inventory:IsWeaponUnlocked(name) then names[#names + 1] = name end end
		table.sort(names)
		for _, name in ipairs(names) do values[#values + 1] = {Value = name, Label = name} end
		return values
	end
	function M:MapOptions()
		local values = {{Value = "Auto", Label = "자동 선택"}, {Value = "Random", Label = "무작위"}}
		for _, name in ipairs(env.mapNames) do values[#values + 1] = {Value = name, Label = name} end
		return values
	end
	local function bindMatch(current)
		if current == match then return end
		matchScope:Destroy() matchScope = env.scope.new()
		match, pending, selectionRevision, mapChoice, weaponChoice = current, {}, 0, nil, nil
		finishedAt, finishedSeen, returning = nil, false, false
