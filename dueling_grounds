		if not self.ready or not self.alive or not window.Alive then return end
		local ok, value = pcall(window.ExportConfig, window)
		if not ok then report(value) return end
		if value == snapshot then return end
		snapshot, self.dirty = value, true
		if env.now() - self.lastSavedAt >= 0.5 then self:Flush() end
	end
	function M:Attach(target, apply)
		assert(not window and self.alive, "설정 저장 연결이 이미 생성되었습니다")
		window = target
		if type(env.resumeConfig) ~= "string" then
			local called, loaded, result = pcall(window.LoadConfig, window, "dueling-combat")
			self.restored = called and loaded == true
			if not self.restored then self.loadError = tostring(called and result or loaded) end
		end
		local beforeApply = window:ExportConfig()
		apply()
		snapshot, theme = window:ExportConfig(), window:GetTheme()
		self.ready = true
		if snapshot ~= beforeApply then self.dirty = true self:Flush() end
		local nextCheck = env.now() + 0.5
		window:Give(env.heartbeat:Connect(function()
			if not self.alive or not window.Alive or env.now() < nextCheck then return end
			nextCheck = env.now() + 0.5
			local current = window:GetTheme()
			if current ~= theme then theme = current self:Changed() end
