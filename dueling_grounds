			queueSent = false
			matchScope:Give(current.SelectionUpdated:Connect(function() selectionRevision = selectionRevision + 1 wake() end))
			for _, signal in ipairs({current.PhaseChanged, current.RoundStateChanged, current.Finished, current.PostMatchCountdownChanged}) do
				matchScope:Give(signal:Connect(wake))
			end
		else nextQueue = env.now() + M.options.delay end
	end
	local function modeForQueue()
		local party = env.party:GetParty()
		local mode = M.options.mode
		if mode == "Auto" then mode = party and "casual2v2" or "casual1v1" end
		if mode ~= "casual1v1" and mode ~= "casual2v2" and mode ~= "ranked1v1" then return nil, "매치 종류를 다시 선택하세요" end
		if party then
			if mode ~= "casual2v2" then return nil, "1대1은 파티를 나간 뒤 참가할 수 있습니다" end
			if not env.party:IsLeader() then return nil, "파티장의 매치 참가를 기다립니다" end
		end
		local gate = mode == "casual2v2" and "Casual2v2Mode" or mode == "ranked1v1" and "RankedMode" or nil
		if gate and not env.progression:IsGateUnlocked(gate) then return nil, "선택한 매치 종류가 아직 잠겨 있습니다" end
		return mode
	end
	local function pickMap(selection)
		local available = selection.availableMaps or {}
		local preferred = M.options.map
		if preferred == "Random" or (preferred ~= "Auto" and available[preferred]) then return preferred end
		if available.Classic then return "Classic" end
		for _, name in ipairs(env.mapNames) do if available[name] then return name end end
