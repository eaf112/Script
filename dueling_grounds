	end
	function M:SetEnabled(value)
		local enabled = value == true and supported
		if self.enabled == enabled then return end
		self.enabled = enabled
		if self.queued then
			self.message = "이미 실행기에 예약을 전달했습니다 · 현재 예약은 자동 취소하지 않습니다"
