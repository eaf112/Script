		self.queued = true
		local ok, problem = pcall(env.queueOnTeleport, code)
		self.accepted = ok
		self.message = ok and "서버 이동 후 설정·전투 상태 복원 예약 전달됨" or "재실행 예약 오류: " .. tostring(problem)
		publish()
		return ok, problem
	end
	if supported then scope:Give(env.player.OnTeleport:Connect(function(state)
		if state == Enum.TeleportState.Started then
			local ok, problem = pcall(function() M:Queue() end)
			if not ok then M.message = "재실행 예약 준비 오류: " .. tostring(problem) publish() end
		elseif state == Enum.TeleportState.Failed then
			M.message = "서버 이동 실패 · 재실행 예약 처리는 실행기 상태를 확인하세요"
			publish()
		end
	end)) end
	function M:Destroy()
		scope:Destroy()
		self.onChanged = nil
	end
	return M
end

end)()
factories.farm = (function()
return function(env)
	local scope, matchScope = env.scope.new(), env.scope.new()
	local M = {alive = true, enabled = false, initialized = false, state = "OFF", message = "오토팜 꺼짐",
		options = {mode = "Auto", map = "Auto", weapon = "Auto", delay = 5},
