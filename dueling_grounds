		if env.player:GetAttribute("InCustomLobby") then status("WAIT", "사용자 지정 방을 나간 뒤 매치를 찾습니다") return end
		if match then
			if not match:GetLocalCombatant() then status("WAIT", "참가자 정보 대기") return end
			if match.IsFinished then
				finishedAt = finishedAt or now
				if not finishedSeen then finishedSeen = true self.stats.completed = self.stats.completed + 1 end
				if now - finishedAt < self.options.delay or env.cinematics.ActiveCinematic or env.cinematics.IsCinematicLoading then
					status("RESULT", "경기 결과와 연출 종료 대기") return
				end
				if not returning then
					prepareTransfer()
					returning = true self.stats.returns = self.stats.returns + 1
					env.matchRemotes.RequestReturnToLobby:FireServer(match.MatchId)
				end
				status("RETURN", "로비 복귀 후 다음 매치 참가") return
			end
			if match.Phase == "Selection" then
				local selection = match.SelectionState
				if type(selection) ~= "table" or not env.inventory.IsStateLoaded then status("SELECT", "선택 정보와 보유 무기 대기") return end
				if mapChoice and mapChoice ~= "Random" and not (selection.availableMaps or {})[mapChoice] then mapChoice, pending.Map = nil, nil end
				mapChoice, weaponChoice = mapChoice or pickMap(selection), weaponChoice or pickWeapon()
				select("Map", mapChoice, (selection.mapVotes or {})[key], now)
				select("Weapon", weaponChoice, (selection.weaponPicks or {})[key], now)
				status("SELECT", "맵 " .. tostring(mapChoice) .. " · 무기 " .. tostring(weaponChoice or "보유 무기 대기")) return
			end
			status(match.RoundState == "Active" and "FIGHT" or "WAIT", match.RoundState == "Active" and "자동 전투 진행" or "다음 라운드 대기")
