				env.fileWrite(self.path, snapshot)
				if type(env.fileRead) == "function" then assert(env.fileRead(self.path) == snapshot, "설정 파일 재읽기 검증 실패") end
				return self.path
			end)
			saved = called
		else
			report("설정 저장에 사용할 파일 접근 기능이 없습니다")
			return false, self.lastError
		end
		if not called or not saved then report(called and result or saved) return false, self.lastError end
		self.path, self.dirty, self.lastSavedAt, self.lastError, warned = result, false, env.now(), nil, false
		return true, result
	end
