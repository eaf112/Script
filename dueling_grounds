		end
		publish()
	end
	function M:Queue()
		if not scope.alive or not self.enabled or self.queued or not supported then return false end
		if not env.window or not env.window.Alive then return false end
		if env.settings then env.settings:Flush() end
		local config = env.window:ExportConfig()
		local code = "local __DUEL_SOURCE = " .. string.format("%q", env.selfSource)
