arams.new()\n\t\tparams.FilterType = Enum.RaycastFilterType.Exclude\n\t\tparams.FilterDescendantsInstances = {c}\n\t\tparams.RespectCanCollide = true\n\t\tlocal floor = not (options and options.exactHeight) and workspace:Raycast(position + Vector3.new(0, 8, 0), Vector3.new(0, -128, 0), params)\n\t\tif floor then\n\t\t\tlocal height = h.HipHeight + root.Size.Y / 2\n\t\t\tlocal leg = h.RigType == Enum.HumanoidRigType.R6 and c:FindFirstChild(\"Left Leg\")\n\t\t\tif leg then height = height + leg.Size.Y end\n\t\t\tposition = Vector3.new(position.X, floor.Position.Y + height, position.Z)\n\t\tend\n\t\tM.nav = {character = c, target = position, radius = radius or 4, label = label, since = os.clock()}\n\t\tif options then M.nav.holdSeconds, M.nav.completed, M.nav.startedHold = options.hold, options.completed, options.startedHold end\n\t\tif options and options.tween then\n\t\t\tlocal duration = math.max((position - root.Position).Magnitude / math.clamp(h.WalkSpeed, 8, 30), 0.25)\n\t\t\tlocal force = Instance.new(\"BodyForce\")\n\t\t\tforce.Name, force.Force, force.Parent = \"구매 이동 중 중력 보정\", Vector3.new(0, root.AssemblyMass * workspace.Gravity, 0), root\n\t\t\tM.nav.gravityForce, M.nav.duration = force, duration\n\t\t\tM.nav.tween = game:GetService(\"TweenService\"):Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(position) * root.CFrame.Rotation})\n\t\t\troot.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)\n\t\t\tM.nav.tween:Play()\n\t\t\tM.log(label .. \" 트윈 이동\")\n\t\t\treturn\n\t\tend\n\t\tif options and options.hold then\n\t\t\tlocal force = Instance.new(\"BodyPosition\")\n\t\t\tforce.Name, force.Position = \"운반 공중 대기\", position\n\t\t\tforce.MaxForce = Vector3.new(0, math.max(root.AssemblyMass, 1) * workspace.Gravity * 8, 0)\n\t\t\tforce.P, force.D, force.Parent = 25000, 2000, root\n\t\t\tM.nav.holdForce, M.nav.holdSeconds, M.nav.completed = force, options.hold, options.completed\n\t\tend\n\t\tlocal offset = position - root.Position\n\t\tc:PivotTo(c:GetPivot() + offset)\n\t\troot.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)\n\t\tM.log(label .. \" 텔레포트\")\n\tend\n\tfunction M.pivotReturn(cf, label)\n\t\tlocal character = M.character()\n\t\tassert(character, \"캐릭터가 없습니다\")\n\t\tM.stopMove()\n\t\tM.motion.release()\n\t\tcharacter:PivotTo(cf)\n\t\tM.lastBaseReturn = {cframe = cf, baseId = env.returnPoint and env.returnPoint.baseId, at = os.clock()}\n\t\tM.log(label .. \" · 현재 내 기지로 순간이동\")\n\tend\n\tfunction M.moveTick()\n\t\tlocal job = M.nav\n\t\tif not job then return end\n\t\tlocal c, _, root = M.character()\n\t\tif c ~= job.character then M.stop(\"텔레포트 중 캐릭터가 변경됐습니다\"); return end\n\t\tlocal now = os.clock()\n\t\tM.lastMove = {label = job.label, target = job.target, position = root.Position, distance = (root.Position - job.target).Magnitude, age = now - job.since}\n\t\tif job.tween then\n\t\t\tlocal state = job.tween.PlaybackState\n\t\t\tif state == Enum.PlaybackState.Cancelled then M.stop(\"구매 이동 트윈이 취소됐습니다\"); return end\n\t\t\tif state ~= Enum.PlaybackState.Completed then\n\t\t\t\tif now - job.since > job.duration + 3 then M.stop(\"구매 이동 트윈의 완료를 확인하지 못했습니다\") end\n\t\t\t\treturn\n\t\t\tend\n\t\t\tjob.tween:Destroy(); job.tween = nil\n\t\t\tjob.since, job.arrivedAt = now, nil\n\t\t\troot.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.new(0, 0, 0), Vector3.new(0, 0, 0)\n\t\t\tif job.holdSeconds then\n\t\t\t\tlocal force = Instance.new(\"BodyPosition\")\n\t\t\t\tforce.Name, force.Position = \"운반 공중 대기\", job.target\n\t\t\t\tforce.MaxForce = Vector3.new(0, math.max(root.AssemblyMass, 1) * workspace.Gravity * 8, 0)\n\t\t\t\tforce.P, force.D, force.Parent = 25000, 2000, root\n\t\t\t\tjob.holdForce = force\n\t\t\tend\n\t\tend\n\t\tif (root.Position - job.target).Magnitude <= math.max(job.radius, 4) then\n\t\t\tif not job.arrivedAt and job.holdSeconds and job.startedHold then job.startedHold() end\n\t\t\tjob.arrivedAt = job.arrivedAt or now\n\t\t\tjob.samples = (job.samples or 0) + 1\n\t\t\tif job.samples >= 2 and now - job.arrivedAt >= (job.holdSeconds or M.pace.position) then\n\t\t\t\tif job.completed then job.completed() end\n\t\t\t\tM.stopMove(); M.nextTick = 0\n\t\t\tend\n\t\telse\n\t\t\tjob.arrivedAt, job.samples = nil, 0\n\t\t\tif now - job.since >= M.pace.correction then M.stop(\"텔레포트 위치가 유지되지 않아 정지했습니다\") end\n\t\tend\n\tend\n\tfunction M.start()\n\t\tassert(M.character(), \"캐릭터가 없습니다\")\n\t\tM.prepareRestart()\n\t\tM.readyAt = {}\n\t\tM.disguiseAckAt, M.disguiseBlocked, M.afterDepositAt = nil, false, nil\n\t\tM.motion.prepare()\n\t\tif env.support then env.support.stopHop(\"자동 훔치기 실행\") end\n\t\tM.running, M.phase = true, \"알 변신 준비\"\n\t\tlocal follow = P:FindFirstChild(\"DisguiseFollow\")\n\t\tif not P:GetAttribute(\"Disguised\") and not P:GetAttribute(\"Carrying\") and not P:GetAttribute(\"StealBase\") and not (follow and follow.Value) then\n\t\t\tM.cycle = M.cycle + 1\n\t\t\tM.clearCycle()\n\t\tend\n\t\tM.motion.start()\n\t\tM.log(\"자동 훔치기 시작\")\n\tend\n\tfunction M.tick()\n\t\tM.checkRequests()\n\t\tif not M.disguiseReady() then return end\n\t\tif env.purchase then\n\t\t\tlocal active = env.purchase.tick()\n\t\t\tif active or env.purchase.job or env.recovery and env.recovery.job then return end\n\t\tend\n\t\tif not M.running then return end\n\t\tlocal carrying = P:GetAttribute(\"Carrying\")\n\t\tif not carrying and M.wasCarrying then\n\t\t\tM.depositAt = M.depositAt or os.clock()\n\t\t\tlocal steals = P:GetAttribute(\"Steals\") or 0\n\t\t\tif steals > (M.stealsBefore or steals) then\n\t\t\t\tM.completed = M.completed + 1\n\t\t\t\tM.clearCycle()\n\t\t\t\tM.cycle = M.cycle + 1\n\t\t\t\tM.afterDepositAt = os.clock()\n\t\t\t\tM.phase = \"입고 확인 · 다음 자동 변신 준비\"\n\t\t\t\tM.log(\"훔치기 횟수 증가 확인 · 다음 변신 계속\")\n\t\t\t\tM.motion.start()\n\t\t\telseif os.clock() - M.depositAt >= 1.5 then M.wasCarrying = false; M.stop(\"운반이 끝났지만 획득은 확인되지 않았습니