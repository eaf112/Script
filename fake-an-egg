ken; break end\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\tif still and not token then\n\t\t\t\t\t\tlocal rendered = row.model:GetPivot().Position\n\t\t\t\t\t\tdelta, mode = (Vector2.new(rendered.X, rendered.Z) - pos).Magnitude, \"still\"\n\t\t\t\t\tend\n\t\t\t\t\tif delta <= 0.65 then F.routeSuspects[row.id] = true end\n\t\t\t\t\tif delta < distance then best, second, distance = {row = row, token = token, mode = mode}, distance, delta elseif delta < second then second = delta end\n\t\t\t\tend end\n\t\t\t\tif best and distance <= 0.65 and second > distance + 0.8 then\n\t\t\t\t\tcandidates[player] = best\n\t\t\t\t\tclaims[best.row.id] = (claims[best.row.id] or 0) + 1\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tlocal tracked = {}\n\t\tfor player in pairs(active) do\n\t\t\tlocal candidate, trace = candidates[player], F.traces[player]\n\t\t\tlocal row = candidate and candidate.row\n\t\t\tif row and claims[row.id] == 1 then\n\t\t\t\tif not trace or trace.id ~= row.id or trace.model ~= row.model or trace.character ~= player.Character or trace.mode ~= candidate.mode then\n\t\t\t\t\ttrace = {id = row.id, model = row.model, character = player.Character, since = now, samples = 0, mode = candidate.mode}\n\t\t\t\tend\n\t\t\t\tif candidate.mode == \"hop\" and (not trace.token or candidate.token > trace.token) or candidate.mode == \"still\" and (not trace.at or now - trace.at >= 0.35) then trace.samples, trace.at, trace.token = trace.samples + 1, now, candidate.token end\n\t\t\t\tF.traces[player] = trace\n\t\t\t\tif trace.samples >= (candidate.mode == \"hop\" and 3 or 4) and now - trace.since >= (candidate.mode == \"hop\" and 0.8 or 1.5) then tracked[row.id] = player.Name end\n\t\t\telse F.traces[player] = nil end\n\t\tend\n\t\tfor player in pairs(F.traces) do if not active[player] then F.traces[player] = nil end end\n\t\tfor player in pairs(F.playerHistory) do if not active[player] then F.playerHistory[player] = nil end end\n\t\tfor id, history in pairs(F.hopHistory) do if now - history[#history].at > 4 then F.hopHistory[id] = nil end end\n\t\tF.tracked = tracked\n\tend\n\tfunction F.updateRoutes()\n\t\tlocal now = os.clock()\n\t\tif F.routeUpdatedAt and now - F.routeUpdatedAt < 0.09 then return end\n\t\tF.routeUpdatedAt = now\n\t\tF.tracked = {}\n\t\tlocal rows = F.roaming()\n\t\tif F.identity then F.identity.update(rows) end\n\t\tF.trackPlayers(rows)\n\t\tif F.identity then for id, binding in pairs(F.identity.bindings) do F.tracked[id] = binding.owner.Name end end\n\tend\n\tfunction F.routeGate(row)\n\t\tif F.routeBypass(row) then return true end\n\t\tif F.tracked[row.id] then return false, \"변신 플레이어와 동선 일치 · 구매 제외\" end\n\t\tif F.identity and F.identity.pending(row.id) then return false, \"좌표 정밀도·변신 동선 교차 확인 중\" end\n\t\tif F.routeSuspects and F.routeSuspects[row.id] then return false, \"변신 동선 겹침 후보 연속 비교 중\" end\n\t\tfor _, player in ipairs(env.players:GetPlayers()) do\n\t\t\tlocal root = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tlocal follow = player:FindFirstChild(\"DisguiseFollow\")\n\t\t\tif root and player:GetAttribute(\"Disguised\") == true and player:GetAttribute(\"FakeLanded\") == true and not (follow and follow.Value) then\n\t\t\t\tlocal trace = F.traces[player]\n\t\t\t\tif trace and trace.id == row.id then return false, \"가짜 의심 동선 연속 비교 중\" end\n\t\t\t\tlocal history = F.playerHistory[player]\n\t\t\t\tif not history or #history < 5 or os.clock() - history[1].at < 0.8 then\n\t\t\t\t\tlocal point = row.model:GetPivot().Position\n\t\t\t\t\tif Vector2.new(point.X - root.Position.X, point.Z - root.Position.Z).Magnitude < 6 then return false, \"근처 변신 플레이어 동선 표본 수집 중\" end\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\treturn true\n\tend\n\tfunction F.mark(model, wanted)\n\t\tlocal mark = F.marks[model]\n\t\tif wanted and F.red and model.Parent then\n\t\t\tif not mark or not mark.Parent then\n\t\t\t\tmark = Instance.new(\"Highlight\")\n\t\t\t\tmark.Name, mark.Adornee = \"가짜 알 강조\", model\n\t\t\t\tmark.FillCol