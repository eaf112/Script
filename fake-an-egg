factories["theft_view"] = (function()
return function(env)
	local M, W, P = env.theft, env.window, env.player
	local eggName = env.factories.egg_names(env)
	local section = W:Tab({Id = "theft", Title = "자동 훔치기"}):Section({Title = "알로 위장해 최고 수익 펫 훔치기", Description = "일반 알 이동 → 구매자 기지 도착 → 부화 → 최고 수익 펫 획득 → 내 기지 귀환"})
	local function safe(fn)
		return function(...)
			local ok, why = pcall(fn, ...)
			if not ok then M.log(tostring(why)); W:Notify({Title = "훔치기", Content = tostring(why), Kind = "Warning"}) end
		end
	end
	local options, choices = {}, M.choices()
	local selectedValid = false
	for _, d in ipairs(choices) do options[#options + 1] = {Value = d.name, Label = eggName(d.name, d.label)}; if d.name == M.selected then selectedValid = true end end
	if not selectedValid then M.selected = nil end
	M.selected = M.selected or choices[1] and choices[1].name
	local choice = section:Dropdown({Text = "위장할 알", Options = options, Default = M.selected, Searchable = true, Callback = function(v) M.selected = v end})
	local status = section:Label({Text = "정지"})
	local target = section:Label({Text = "상대 기지에서 실제 수익이 가장 높은 펫을 자동 선택합니다."})
	section:Button({Text = "자동 훔치기 시작", Callback = safe(M.start)})
	section:Button({Text = "전체 정지", Callback = function() M.stop("사용자가 정지했습니다") end})
	section:Button({Text = "최소화", Callback = function() W:Minimize() end})
	section:Button({Text = "종료", Callback = function() W:Destroy() end})
	local note = section:Label({Text = "다른 플레이어가 알을 구매해 기지로 가져가면 자동으로 이어집니다."})
	local nextAt = 0
	M.connect(env.run.Heartbeat, function()
		if os.clock() < nextAt then return end
		nextAt = os.clock() + 0.5
		status:SetText((M.running and "실행 중 · " or "정지 · ") .. M.phase)
		local best = M.best
		target:SetText(best and best.owner.DisplayName .. "의 " .. best.raw .. "\n실제 계산 수익 " .. string.format("%.0f", best.cps) .. "/초" or "기지에 들어가면 수익·변종·크기·특성을 비교해 최고 펫을 고릅니다.")
		local lines = {}
		for i = math.max(1, #M.logs - 2), #M.logs do lines[#lines + 1] = M.logs[i] end
		note:SetText(table.concat(lines, "\n"))
	end)
	return {status = status, choice = choice}
end
end)()
factories["theft_entry"] = (function()
return function(env)
