				local d = (state.x - h.fx) ^ 2 + (state.z - h.fz) ^ 2
				if h.id ~= env.ownEggId() and now - h.received < 1.5 and not M.used[key] and inside(x, z) and (not distance or d < distance) then nearest, distance = h, d end
			end
			if nearest then
				local h = nearest
				local key = tostring(h.id) .. ":" .. tostring(h.t0)
				local x, z = state.x + h.x - h.fx, state.z + h.z - h.fz
				state.queue = {{id = env.ownEggId(), fx = state.x, fy = state.y, fz = state.z, x = x, y = M.ground(x, z, state.y), z = z, t0 = now, dur = h.dur, h = h.h}}
				M.used[key], M.hops = now, M.hops + 1
			end
		end
		for key, at in pairs(M.used) do if now - at > 5 then M.used[key] = nil end end
		local x, y, z, lift, squash, angle, idle = M.native.pose(state, now)
		root.CFrame = CFrame.new(x, y + M.offset, z) * root.CFrame.Rotation
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		M.lastPosition = root.Position
		return x, y, z, lift, squash, angle, idle
	end
	function M.release()
		if M.state then
			M.state.queue = M.oldQueue or {}
			M.state.ownPhase, M.state.handedOff = 0, true
			M.state.landedAt, M.state.landAmount = workspace:GetServerTimeNow(), 0.08
		end
		M.state, M.oldQueue, M.lastPosition = nil, nil, nil
	end
	function M.failed(why)
		M.stop(); env.failure("알 이동 정지: " .. why)
	end
	function M.start()
		M.prepare(); M.enabled = true; M.native.controller = M
	end
	function M.stop()
		M.enabled = false
		if M.native and M.native.controller == M then M.native.controller = nil end
		M.release()
	end
	return M
end
end)()
