factories["motion"] = (function()
return function(env)
	local P = env.player
	local M = { enabled = false, samples = {}, used = {}, native = nil, state = nil, packets = 0, hops = 0 }
	local function has(constants, key)
		for _, v in pairs(constants) do if v == key then return true end end
		return false
	end
	function M.prepare()
		local scriptObject = P.PlayerScripts:FindFirstChild("Eggs")
		local shared = getgenv()
		local native = shared.EGG_NATIVE_MOTION
		if native and native.schema == 2 and native.script == scriptObject then M.native = native; return end
		assert(type(getreg) == "function" and type(getupvalues) == "function" and type(getconstants) == "function" and type(hookfunction) == "function", "현재 실행기에서 게임의 알 이동 함수를 연결할 수 없습니다")
		if native and native.target and native.original then pcall(hookfunction, native.target, native.original) end
		local source = assert(scriptObject, "게임 알 스크립트 없음"):GetFullName()
		local queue, seen = {}, {}
		local function add(fn)
			if type(fn) ~= "function" or seen[fn] then return end
			local ok, path = pcall(debug.info, fn, "s")
			if ok and path == source then seen[fn] = true; queue[#queue + 1] = fn end
		end
		for _, value in pairs(getreg()) do add(value) end
		local pose, own
		local head = 1
		while head <= #queue and head <= 600 do
			local fn = queue[head]; head = head + 1
			local constants = getconstants(fn)
			local isOwn = has(constants, "ownPhase") and has(constants, "handedOff")
			local isPose = not isOwn and not has(constants, "GetTemplate") and has(constants, "queue") and has(constants, "landAmount") and has(constants, "targetPitch") and has(constants, "swingDir") and has(constants, "dur") and has(constants, "t0")
			if isOwn or isPose then
				if isOwn then assert(not own, "변신 알 이동 함수 중복"); own = fn
				else assert(not pose, "일반 알 이동 함수 중복"); pose = fn end
			end
			for _, value in pairs(getupvalues(fn)) do
				add(value)
				if type(value) == "table" then for _, child in pairs(value) do add(child) end end
			end
		end
		assert(pose and own, "게임의 원본 pose·ownPose 함수를 찾지 못했습니다")
		native = { schema = 2, script = scriptObject, pose = pose, target = own, calls = 0 }
		native.original = hookfunction(own, function(state, now, dt)
			native.calls = native.calls + 1
			local controller = native.controller
			if controller and controller.canControl() then
				local ok, result = pcall(function() return {controller.render(state, now, dt)} end)
				if ok and result[1] ~= nil then return unpack(result) end
				if not ok then controller.failed(tostring(result)) end
			end
			if controller and controller.state then controller.release() end
			return native.original(state, now, dt)
		end)
		shared.EGG_NATIVE_MOTION, M.native = native, native
	end
	function M.canControl()
		local c = P.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		local follow = P:FindFirstChild("DisguiseFollow")
		return M.enabled and P:GetAttribute("Disguised") == true and not P:GetAttribute("Ragdoll") and r and not r.Anchored and not (follow and follow.Value)
	end
	function M.ground(x, z, fallback)
		local ground = workspace:FindFirstChild("EggSpawn")
		assert(ground and ground:IsA("BasePart"), "게임의 알 이동 구역이 없습니다")
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = {ground}
		params.RespectCanCollide = false
		local hit = workspace:Raycast(Vector3.new(x, ground.Position.Y + ground.Size.Y / 2 + 50, z), Vector3.new(0, -200, 0), params)
