		assert(UI and type(UI.CreateWindow) == "function", "지정 UI LIB를 불러오지 못했습니다")
		local shared = getgenv()
		local previous = shared.EGG_GAME_HUB
		local previousTheft = previous and previous.env and previous.env.theft
		local resume = previousTheft and previousTheft.running == true
		local state = {}
		if previousTheft then for _, key in ipairs({"pending", "cycle", "ownId", "lastFollowBase", "wasCarrying", "stealsBefore", "carryAt", "completed", "variant"}) do state[key] = previousTheft[key] end end
		local selected = previous and previous.env and (previous.env.theft and previous.env.theft.selected or previous.env.egg and previous.env.egg.selectedDisguise)
		if previous and previous.window then previous.window:Destroy() end
		env.window = UI:CreateWindow({Id = "egg-game-helper", Title = "알 위장 자동 훔치기", Theme = "CodexDark", Locale = "ko", Width = 620, Height = 500, CloseBehavior = "Minimize"})
		env.players, env.storage = game:GetService("Players"), game:GetService("ReplicatedStorage")
		env.player, env.run = env.players.LocalPlayer, game:GetService("RunService")
		local handle = {window = env.window, env = env, version = "2.1.1"}
		shared.EGG_GAME_HUB = handle
		env.window:OnDestroy(function() if shared.EGG_GAME_HUB == handle then shared.EGG_GAME_HUB = nil end end)
		local ok, why = pcall(function()
			env.theft = env.factories.theft(env)
			for key, value in pairs(state) do env.theft[key] = value end
			env.theft.selected = selected
			env.view = env.factories.theft_view(env)
			if resume then env.theft.motion.start(); env.theft.running = true; env.theft.phase = "텔레포트 방식으로 전환" end
		end)
		if not ok then env.window:Destroy(); error(why, 0) end
		return {ready = true, version = "2.1.1", tabs = #env.window.Tabs, running = env.theft.running, movement = "teleport", purpose = "알 위장·기지 부화·최고 수익 펫 자동 훔치기"}
	end
	return env
end
end)()
