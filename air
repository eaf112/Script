local function newPilot()
	local pilot = {target = nil, targetSince = 0, readyAt = 0, burstUntil = 0, restUntil = 0, cooling = false, direction = nil, elapsed = 0, breakUntil = 0, breakSide = 1, recovering = false, breakArmed = true}
	local random = Random.new()
	local function unit(v, fallback)
		return v.Magnitude > 0.001 and v.Unit or fallback
	end
	local function intercept(relative, velocity, speed)
		local a = velocity:Dot(velocity) - speed * speed
		local b = 2 * relative:Dot(velocity)
		local c = relative:Dot(relative)
		local t
		if math.abs(a) < 0.001 then
			if math.abs(b) > 0.001 then t = -c / b end
		else
			local discriminant = b * b - 4 * a * c
			if discriminant >= 0 then
				local root = math.sqrt(discriminant)
				local t1, t2 = (-b - root) / (2 * a), (-b + root) / (2 * a)
				if t1 > 0 then t = t1 end
				if t2 > 0 and (not t or t2 < t) then t = t2 end
			end
		end
		return t and t > 0 and math.min(t, 2.5) or 0
	end
	local function turn(current, desired, limit)
		local dot = math.clamp(current:Dot(desired), -1, 1)
		local angle = math.acos(dot)
		if angle <= limit then return desired end
		local axis = current:Cross(desired)
		if axis.Magnitude < 0.001 then
			axis = current:Cross(Vector3.new(0, 1, 0))
			if axis.Magnitude < 0.001 then axis = current:Cross(Vector3.new(1, 0, 0)) end
		end
		return CFrame.fromAxisAngle(axis.Unit, limit) * current
	end
	function pilot:Reset()
		self.target, self.direction = nil, nil
		self.readyAt, self.burstUntil, self.restUntil = 0, 0, 0
		self.cooling = false
		self.breakUntil, self.recovering = 0, false
		self.breakArmed = true
	end
	function pilot:Step(s, dt, settings)
		self.elapsed = self.elapsed + dt
		local now = self.elapsed
		local own, selected, best, held = s.own, nil, math.huge, nil
		for _, candidate in ipairs(s.targets) do
			local relative = candidate.position - own.position
			local distance = relative.Magnitude
			if distance > 1 and distance < settings.range then
				local dot = own.forward:Dot(relative.Unit)
				local score = distance * (1.4 - dot * 0.65)
				score = score * (0.8 + math.clamp(candidate.hp, 0, 1) * 0.2)
				if candidate.forward:Dot(-relative.Unit) > 0.8 and dot < 0 then score = score * 0.78 end
				if candidate.id == self.target then held = {candidate = candidate, score = score} end
				if score < best then best, selected = score, candidate end
			end
		end
		if held and (now - self.targetSince < 1.4 or best > held.score * 0.7) then selected = held.candidate end
		if selected and selected.id ~= self.target then
			self.target, self.targetSince = selected.id, now
			self.readyAt = now + random:NextNumber(0.14, 0.23)
			self.burstUntil, self.restUntil = 0, 0
			self.breakArmed = true
		elseif not selected then
			self.target = nil
		end
		local desired = own.forward
		local aim, distance, mode = nil, 0, "탐색"
		if selected then
			local relative = selected.position - own.position
			distance = relative.Magnitude
			local flightTime = s.hitscan and 0 or intercept(relative, selected.velocity - own.velocity, s.bulletSpeed)
			aim = selected.position + (selected.velocity - own.velocity) * flightTime + Vector3.new(0, 15 * flightTime * flightTime, 0)
			local offset = own.right * math.sin(now * 1.7) + own.up * math.sin(now * 1.13 + 1)
			local noise = math.tan(math.rad(settings.error)) * distance
			desired = unit(aim + offset * noise - own.position, own.forward)
			mode = "추격"
			if distance > 250 then self.breakArmed = true end
			if distance < 130 and self.breakArmed and relative.Unit:Dot(own.forward) > -0.2 and now > self.breakUntil then
				self.breakUntil = now + 0.85
				self.breakSide = own.right:Dot(relative) > 0 and -1 or 1
				self.breakArmed = false
			end
		else
			local tangent = Vector3.new(-own.position.Z, 0, own.position.X)
			local inward = Vector3.new(-own.position.X, 0, -own.position.Z)
			desired = unit(tangent + inward * 0.35 + Vector3.new(0, (650 - own.position.Y) * 2, 0), own.forward)
		end
		if s.threat and distance > 180 then
			local weave = own.right * math.sin(now * 2.7) * 0.55 + own.up * math.sin(now * 1.7) * 0.22
			desired = unit(desired + weave, own.forward)
			mode = "회피 기동"
		end
		local speed = own.velocity.Magnitude
		local minimum = s.minSpeed or 90
		if speed < minimum then self.recovering = true end
		if speed > minimum * 1.15 then self.recovering = false end
		if now < self.breakUntil then
			local forward = unit(Vector3.new(own.forward.X, 0, own.forward.Z), Vector3.new(0, 0, -1))
			local right = unit(Vector3.new(own.right.X, 0, own.right.Z), forward:Cross(Vector3.new(0, 1, 0)))
			desired = unit(forward + right * self.breakSide * 0.45 + Vector3.new(0, math.clamp((550 - own.position.Y) / 900, -0.15, 0.12), 0), forward)
			mode = "근접 이탈"
		end
		if self.recovering then
			local forward = unit(Vector3.new(own.forward.X, 0, own.forward.Z), Vector3.new(0, 0, -1))
			desired = unit(forward + Vector3.new(0, own.position.Y > 550 and -0.12 or 0, 0), forward)
			mode = "속도 회복"
		else
			local climb = speed < minimum * 1.4 and 0.28 or 0.45
			if desired.Y > climb or desired.Y < -0.4 then
				local y = math.clamp(desired.Y, -0.4, climb)
				local fallback = unit(Vector3.new(own.forward.X, 0, own.forward.Z), Vector3.new(0, 0, -1))
				local horizontal = unit(Vector3.new(desired.X, 0, desired.Z), fallback)
				desired = horizontal * math.sqrt(1 - y * y) + Vector3.new(0, y, 0)
			end
		end
		local radial = Vector3.new(own.position.X, 0, own.position.Z)
		local predicted = own.position + own.velocity * 2.5
		local limit = s.zoneRadius - 350
		if radial.Magnitude > limit or Vector3.new(predicted.X, 0, predicted.Z).Magnitude > s.zoneRadius - 150 then
			desired = unit(-radial + Vector3.new(0, math.max(0, 550 - own.position.Y), 0), own.forward)
			mode = "구역 복귀"
		end
		if own.position.Y > s.ceiling - 160 then
			desired = unit(Vector3.new(desired.X, math.min(desired.Y, -0.4), desired.Z), own.forward)
			mode = "고도 조절"
		end
		if s.collision then desired, mode = s.collision, "충돌 회피" end
		if s.avoid then desired, mode = s.avoid, "지형 회피" end
		self.direction = turn(self.direction or own.forward, desired, math.rad(settings.turnRate) * math.min(dt, 0.05))
		self.direction = turn(own.forward, self.direction, math.rad(75))
		local fire = false
		if s.heat > 0.78 or s.jammed then self.cooling = true end
		if s.heat < 0.34 and not s.jammed then self.cooling = false end
		local aligned = aim and own.forward:Dot(unit(aim - own.position, own.forward)) > math.cos(math.rad(2.5))
		local attackMode = mode == "추격" or mode == "회피 기동"
		if selected and aligned and distance > 100 and distance < s.weaponRange * 0.95 and s.clear and now >= self.readyAt and attackMode and not self.cooling then
			if now >= self.restUntil then
				if self.burstUntil == 0 then self.burstUntil = now + random:NextNumber(0.85, 1.5) end
				if now < self.burstUntil then
					fire, mode = true, "사격"
				else
					self.burstUntil = 0
					self.restUntil = now + random:NextNumber(0.1, 0.2)
				end
			end
		else
			self.burstUntil = 0
		end
		if self.cooling and mode == "추격" then mode = "냉각" end
		local reason = "추격"
		if not selected then reason = "표적 없음"
		elseif not attackMode then reason = mode
		elseif distance <= 100 then reason = "지나치게 가까움"
		elseif distance >= s.weaponRange * 0.95 then reason = "사거리 밖"
		elseif not aligned then reason = "조준 정렬 중"
		elseif not s.clear then reason = "사선 차단"
		elseif self.cooling then reason = "냉각"
		elseif now < self.readyAt then reason = "반응 대기"
		elseif not fire then reason = "연사 간격"
		else reason = "사격" end
		return {direction = self.direction, fire = fire, target = selected, mode = mode, distance = distance, boost = (self.recovering or s.gunThreat) and not s.avoid, fireReason = reason, gunThreat = s.gunThreat}
	end
	return pilot
end

local function chooseEvasion(s, desired)
	local speed = s.speed
	local function danger(direction)
		local score, urgent = 0, false
		for _, hazard in ipairs(s.hazards) do
			local relative = hazard.position - s.position
			local velocity = hazard.velocity - direction * speed
			local time = math.clamp(-relative:Dot(velocity) / math.max(velocity:Dot(velocity), 1), 0, math.min(hazard.remaining, 1.2))
			local miss = (relative + velocity * time + (hazard.gravity or Vector3.zero) * (time * time * 0.5)).Magnitude
			local radius = hazard.radius or 40
			if time > 0.005 or relative.Magnitude < radius then
				score = score + math.exp(-((miss / radius) ^ 2)) * (hazard.missile and 4 or 1) / (time + 0.08)
				if miss < radius and time < 0.24 then urgent = true end
			end
		end
		return score, urgent
	end
	local baseline, urgent = danger(desired)
	if s.current and s.current.Magnitude > 1 then
		local _, incoming = danger(s.current.Unit)
		urgent = urgent or incoming
	end
	if baseline < 0.03 then return desired, false, urgent end
	local choices = {desired}
	for x = -1, 1 do
		for y = -1, 1 do
			for z = -1, 1 do
				local vector = Vector3.new(x, y, z)
				if vector.Magnitude > 0 then table.insert(choices, vector.Unit) end
			end
		end
	end
	local best, bestScore = desired, math.huge
	for _, direction in ipairs(choices) do
		local future = s.position + direction * speed * 1.2
		if future.Y > s.floor and future.Y < s.ceiling - 90 and Vector3.new(future.X, 0, future.Z).Magnitude < s.zoneRadius - 100 and (not s.blocked or not s.blocked(direction)) then
			local score = danger(direction) + (1 - direction:Dot(desired)) * 0.025
			if s.previous then score = score + (1 - direction:Dot(s.previous)) * 0.015 end
			if score < bestScore then best, bestScore = direction, score end
		end
	end
	return best, best:Dot(desired) < 0.995, urgent
end

local function newRagePilot()
	local pilot = {target = nil, cooling = false}
	local function unit(v, fallback)
		return v.Magnitude > 0.001 and v.Unit or fallback
	end
	function pilot:Reset()
		self.target, self.cooling = nil, false
	end
	function pilot:Step(s, _, settings)
		local own, selected, best, held = s.own, nil, math.huge, nil
		for _, candidate in ipairs(s.targets) do
			local distance = (candidate.position - own.position).Magnitude
			if distance > 1 and distance < settings.range then
				local score = distance * (0.3 + math.clamp(candidate.cockpitHp or candidate.hp, 0, 1) * 0.7)
				if distance < s.weaponRange * 0.95 then score = score * 0.3 end
				if candidate.firing then score = score * 0.85 end
				if candidate.id == self.target then held = {candidate = candidate, score = score} end
				if score < best then best, selected = score, candidate end
			end
		end
		if held and held.score <= best * 1.1 then selected = held.candidate end
		self.target = selected and selected.id or nil
		local movement, direction = own.forward, own.forward
		local distance, mode = 0, "탐색"
		if selected then
			local relative = (selected.aimPosition or selected.position) - own.position
			local velocity = selected.velocity - own.velocity
			local time = s.hitscan and 0 or math.min(relative.Magnitude / s.bulletSpeed, 2.5)
			for _ = 1, 5 do
				if not s.hitscan then time = math.min((relative + velocity * time + Vector3.new(0, 15 * time * time, 0)).Magnitude / s.bulletSpeed, 2.5) end
			end
			direction = unit(relative + velocity * time + Vector3.new(0, 15 * time * time, 0), own.forward)
			distance = (selected.position - own.position).Magnitude
			local radial = unit(own.position - selected.position, -own.forward)
			local tangent = unit(radial:Cross(Vector3.new(0, 1, 0)), own.right)
			local preferred = math.clamp(s.weaponRange * 0.5, 180, 500)
			if distance > preferred * 1.4 then
				movement, mode = -radial, "고속 접근"
			else
				movement = unit(tangent * 0.9 + radial * math.clamp((preferred - distance) / preferred * 2, -1, 1.5), tangent)
				mode = "횡이동 사격"
			end
			local altitude = math.clamp(selected.position.Y, s.floor + 70, s.ceiling - 180)
			movement = unit(Vector3.new(movement.X, math.clamp((altitude - own.position.Y) / 250, -0.6, 0.8), movement.Z), movement)
		else
			movement = unit(Vector3.new(-own.position.Z - own.position.X * 0.3, (s.floor + 100 - own.position.Y) * 3, own.position.X - own.position.Z * 0.3), own.forward)
		end
		local radial = Vector3.new(own.position.X, 0, own.position.Z)
		if radial.Magnitude > s.zoneRadius - 300 then
			movement, mode = unit(-radial + Vector3.new(0, 100, 0), -own.forward), "구역 복귀"
		end
		if own.position.Y < s.floor then
			movement, mode = unit(Vector3.new(movement.X * 0.5, 1, movement.Z * 0.5), Vector3.new(0, 1, 0)), "고도 확보"
		elseif own.position.Y > s.ceiling - 120 then
			movement, mode = unit(Vector3.new(movement.X, -0.8, movement.Z), Vector3.new(0, -1, 0)), "고도 조절"
		end
		if s.collision then movement, mode = s.collision, "충돌 회피" end
		if s.avoid then movement, mode = s.avoid, "지형 회피" end
		if not selected then direction = movement end
		if s.heat > 0.92 or s.jammed then self.cooling = true end
		if s.heat < 0.4 and not s.jammed then self.cooling = false end
		local fire = selected ~= nil and distance > 35 and distance < s.weaponRange * 0.98 and s.clear and not self.cooling
		local reason = "사격"
		if not selected then reason = "표적 없음"
		elseif self.cooling then reason = "냉각"
		elseif not s.clear then reason = "사선 차단"
		elseif distance >= s.weaponRange * 0.98 then reason = "사거리 밖"
		elseif distance <= 35 then reason = "충돌 거리" end
		return {direction = direction, movement = movement, fire = fire, target = selected, mode = mode, distance = distance, boost = true, snap = true, fireReason = reason}
	end
	return pilot
end

