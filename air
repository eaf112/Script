local function roots(model)
	return model.PrimaryPart or model:FindFirstChild("Koren")
end
local function velocity(part, now)
	local last = samples[part]
	local result = part.AssemblyLinearVelocity
	if last and now - last.time > 0.03 then
		local measured = (part.Position - last.position) / (now - last.time)
		if measured.Magnitude < 1500 then result = last.velocity:Lerp(measured, 0.6) end
	end
	samples[part] = {position = part.Position, time = now, velocity = result}
	return result
end
local function scan(now)
	local aircraft = workspace:FindFirstChild("Avioni")
	ownPlane, ownRoot, candidates = nil, nil, {}
	local keep = {}
	if aircraft then
		for _, plane in ipairs(aircraft:GetChildren()) do
			if plane:IsA("Model") then
				local root = roots(plane)
				if root and root:IsA("BasePart") then
					keep[root] = true
					local vel = velocity(root, now)
					if plane == Damage.mojModel then
						ownPlane, ownRoot = plane, root
					elseif plane:GetAttribute("Vlasnik") ~= player.UserId and plane.Name ~= "Avion_" .. player.UserId and not plane:GetAttribute("Uklanja") and not plane:GetAttribute("PilotMrtav") and not plane:GetAttribute("Zastita") and not Status.Duh(plane) then
						local bot = plane.Name:match("^Bot_") ~= nil
						if not settings.botsOnly or bot then
							local hp = plane:GetAttribute("HP_Trup") or 1
							if hp > 0 then
								local cockpit = plane:FindFirstChild("Sekcija_Kokpit")
								table.insert(candidates, {id = plane, position = root.Position, aimPosition = cockpit and cockpit:IsA("BasePart") and cockpit.Position or root.Position, cockpitHp = plane:GetAttribute("HP_Kokpit"), velocity = vel, forward = root.CFrame.LookVector, hp = hp, firing = plane:GetAttribute("PucaP") == true})
							end
						end
					end
				end
			end
		end
	end
	for part in pairs(samples) do if not keep[part] then samples[part] = nil end end
	local terrain = {workspace.Terrain}
	for _, name in ipairs({"Svet", "Brodovi"}) do
		local folder = workspace:FindFirstChild(name)
		if folder then table.insert(terrain, folder) end
	end
	obstacleParams.FilterDescendantsInstances = terrain
	local sight = table.clone(terrain)
	if aircraft then
		for _, plane in ipairs(aircraft:GetChildren()) do
			if plane ~= ownPlane then table.insert(sight, plane) end
		end
	end
	sightParams.FilterDescendantsInstances = sight
	weapon = {speed = 1400, range = 0, hitscan = false, slots = {}}
	if ownPlane and ownPlane:GetAttribute("Model") then
		local loadout = Weapons.Naoruzanje(ownPlane:GetAttribute("Model"))
		local primary
		for _, mount in ipairs(loadout and loadout[1] or {}) do
			if not mount.zad and Combat.NaMestu(ownPlane, mount.sek) then primary = mount break end
		end
		if primary and primary.def then
			local def = primary.def
			weapon = {speed = def.brzina or 1400, range = def.domet or 950, hitscan = def.vrsta == "zrak" or def.vrsta == "kontinualni" or def.vrsta == "plamen", slots = {}}
		end
		for slot = 2, 3 do
			for _, mount in ipairs(loadout and loadout[slot] or {}) do
				if mount.def and mount.def.vrsta == "raketa" and not mount.def.mina then weapon.slots[slot] = true end
			end
		end
	end
	obstruction, collision, clear, gunThreat = nil, nil, false, false
	if ownRoot then
		local pos, cf = ownRoot.Position, ownRoot.CFrame
		local vel = samples[ownRoot].velocity
		local horizon = math.max(180, vel.Magnitude * 2.8)
		local forward = cf.LookVector * horizon
		if settings.mode == "Rage" and vel.Magnitude > 5 then forward = vel.Unit * horizon end
		local hit = workspace:Raycast(pos, forward, obstacleParams)
		if not hit then hit = workspace:Raycast(pos + cf.RightVector * 12, forward, obstacleParams) end
		if not hit then hit = workspace:Raycast(pos - cf.RightVector * 12, forward, obstacleParams) end
		local low = workspace:Raycast(pos, Vector3.new(0, -160, 0), obstacleParams)
		if hit or low or pos.Y + math.min(vel.Y, 0) * 2.8 < World.VodaY + 85 then
			obstruction = (cf.LookVector * 0.35 + Vector3.new(0, 1, 0)).Unit
		end
		for _, candidate in ipairs(candidates) do
			local relative = candidate.position - pos
			local rv = candidate.velocity - vel
			if relative.Magnitude > 1 and relative.Magnitude < 1100 and candidate.firing and candidate.forward:Dot(-relative.Unit) > 0.94 then gunThreat = true end
			if rv:Dot(rv) > 1 and relative.Magnitude < 500 then
				local time = -relative:Dot(rv) / rv:Dot(rv)
				if not collision and time > 0 and time < 1.8 and (relative + rv * time).Magnitude < 60 then
					local side = cf.RightVector:Dot(relative) > 0 and -1 or 1
					collision = (cf.LookVector * 0.3 + cf.RightVector * side + Vector3.new(0, 0.5, 0)).Unit
				end
			end
		end
		if targetModel and targetModel.Parent then
			local root = roots(targetModel)
			if root then
				local start = pos + cf.LookVector * 32
				local result = workspace:Raycast(start, root.Position - start, sightParams)
				clear = not result or result.Instance:IsDescendantOf(targetModel)
			end
		end
	end
end

local function updateHazards(now)
	hazards = {}
	for key, projectile in pairs(projectiles) do
		local def = projectile.def
		local dt = math.min(now - projectile.updated, 0.25)
		projectile.updated = now
		if now > projectile.expires then
			projectiles[key] = nil
		else
			local steps = math.max(1, math.ceil(dt / 0.025))
			local step = dt / steps
			for _ = 1, steps do
				projectile.speed = math.min(def.maxBrzina or projectile.speed, projectile.speed + (def.ubrzanje or 0) * step)
				local target = projectile.target
				if target and target.Parent and not Status.Duh(target) then
					local root = roots(target)
					if root then
						local time = math.min(3, (root.Position - projectile.position).Magnitude / math.max(projectile.speed, 1))
						local relative = root.Position + root.AssemblyLinearVelocity * time - projectile.position
						if relative.Magnitude > 0.01 then
							local desired = relative.Unit
							local angle = math.acos(math.clamp(projectile.direction:Dot(desired), -1, 1))
							local turn = math.rad(def.okret or 0) * step
							if def.magnetna and Status.Aktivno(target, "magnet") then turn = turn * 1.8 end
							local direction = projectile.direction:Lerp(desired, angle > 0.001 and math.min(1, turn / angle) or 1)
							if direction.Magnitude > 0.001 then projectile.direction = direction.Unit end
						end
					end
				end
				projectile.velocity = projectile.direction * projectile.speed
				projectile.position = projectile.position + projectile.velocity * step
			end
			if ownRoot and (projectile.position - ownRoot.Position).Magnitude < 1600 then
				table.insert(hazards, {position = projectile.position, velocity = projectile.velocity, radius = math.max(def.blizina or 0, def.radius or 0, 30) + 22, remaining = projectile.expires - now, missile = true})
			end
		end
	end
	if now >= gunAt then
		gunAt = now + 0.09
		for _, candidate in ipairs(candidates) do
			local relative = ownRoot and ownRoot.Position - candidate.position
			if relative and relative.Magnitude > 1 and relative.Magnitude < 1800 and candidate.firing and candidate.forward:Dot(relative.Unit) > 0.65 then
				local loadout = Weapons.Naoruzanje(candidate.id:GetAttribute("Model"))
				for _, mount in ipairs(loadout and loadout[1] or {}) do
					if not mount.zad and mount.def and Combat.NaMestu(candidate.id, mount.sek) then
						local def = mount.def
						local speed = def.brzina or 1400
						if def.vrsta == "zrak" or def.vrsta == "kontinualni" then speed = 12000 end
						table.insert(gunWaves, {position = candidate.position + candidate.forward * 32, velocity = candidate.forward * speed + candidate.velocity, born = now, expires = now + math.min(2, (def.domet or 1000) / speed), gravity = Vector3.new(0, -30, 0), radius = 36})
						break
					end
				end
			end
		end
	end
	for index = #gunWaves, 1, -1 do
		local wave = gunWaves[index]
		if now > wave.expires or #gunWaves > 128 then
			table.remove(gunWaves, index)
		else
			local age = now - wave.born
			table.insert(hazards, {position = wave.position + wave.velocity * age + wave.gravity * (age * age * 0.5), velocity = wave.velocity + wave.gravity * age, gravity = wave.gravity, radius = wave.radius, remaining = wave.expires - now})
		end
	end
end

local function safePoint(point)
	if point.Y < World.VodaY + 90 or point.Y > World.ZonaPlafon - 100 or Vector3.new(point.X, 0, point.Z).Magnitude > World.ZonaRadijus - 150 then return false end
	for _, ray in ipairs({Vector3.new(0, -65, 0), Vector3.new(0, 35, 0), Vector3.new(35, 0, 0), Vector3.new(-35, 0, 0), Vector3.new(0, 0, 35), Vector3.new(0, 0, -35)}) do
		if workspace:Raycast(point, ray, obstacleParams) then return false end
	end
	return true
end

local function collectPickup(now)
	if not settings.pickups or jump or now < jumpAt then return end
	local folder = workspace:FindFirstChild("Pojacanja")
	if not folder then return end
	local serverNow, selected, best = workspace:GetServerTimeNow(), nil, -math.huge
	local function remaining(kind) return math.max(0, (ownPlane:GetAttribute("Ef_" .. kind) or 0) - serverNow) end
	for part, untilTime in pairs(pickupAttempts) do if not part.Parent or now > untilTime then pickupAttempts[part] = nil end end
	for _, part in ipairs(folder:GetChildren()) do
		if part:IsA("BasePart") and not pickupAttempts[part] and (not part:GetAttribute("Kraj") or part:GetAttribute("Kraj") > serverNow + 0.7) then
			local kind, priority = part:GetAttribute("Tip"), 0
			if kind == "stit" and remaining("stit") < 1.1 then priority = 100 end
			if kind == "duh" and remaining("duh") < 1.1 then priority = #hazards > 0 and 85 or 65 end
			if kind == "popravka" and math.min(ownPlane:GetAttribute("HP_Trup") or 1, ownPlane:GetAttribute("HP_Kokpit") or 1) < 0.8 then priority = 90 end
			if (kind == "steta2" or kind == "trostruka" or kind == "brzaPaljba") and remaining(kind) < 1.1 then priority = 25 end
			local score = priority - (part.Position - ownRoot.Position).Magnitude / 2500
			if priority > 0 and score > best and safePoint(part.Position) then selected, best = part, score end
		end
	end
	if selected then
		jump = {position = selected.Position, part = selected, kind = selected:GetAttribute("Tip"), untilTime = now + 0.5, reason = "강화 아이템 수집"}
		pickupAttempts[selected] = now + 10
		jumpAt = now + 1.1
	end
end

local function update(dt, cf)
	local now = os.clock()
	if now >= scanAt then scanAt = now + (settings.mode == "Rage" and 0.035 or 0.1) scan(now) end
	if not ownPlane or not ownRoot or not ownRoot.Parent then
		releaseFire()
		pilot:Reset()
		ragePilot:Reset()
		state = {mode = "출격 대기", fire = false}
		return nil
	end
	if ownPlane:GetAttribute("PilotMrtav") then
		releaseFire()
		pilot:Reset()
		ragePilot:Reset()
		state = {mode = "조종사 사망", fire = false}
		return nil
	end
	local frame = cf or ownRoot.CFrame
	local mod = Status.Mod(ownPlane)
	local stats = Balance[ownPlane:GetAttribute("Model")]
	local controller = settings.mode == "Rage" and ragePilot or pilot
	local result = controller:Step({
		own = {position = ownRoot.Position, velocity = samples[ownRoot].velocity, forward = frame.LookVector, right = frame.RightVector, up = frame.UpVector},
		targets = candidates, bulletSpeed = weapon.speed, weaponRange = weapon.range, hitscan = weapon.hitscan,
		heat = Combat.toplota or 0, jammed = Combat.zaglavljen, clear = clear, avoid = obstruction,
		threat = Combat.pretnja ~= nil or gunThreat, gunThreat = gunThreat, zoneRadius = World.ZonaRadijus, ceiling = World.ZonaPlafon, collision = collision, minSpeed = stats and stats.vMin * 1.4 or 82,
		floor = (World.MaxTeren or 395) + 180,
	}, dt, settings)
	if settings.mode == "Rage" then
		if now >= defenseAt then
			defenseAt = now + 0.035
			updateHazards(now)
			local previousMovement = defenseMovement
			defenseMovement, defenseChanged, defenseUrgent = result.movement, false, false
			if settings.evasion then
				defenseMovement, defenseChanged, defenseUrgent = chooseEvasion({position = ownRoot.Position, current = ownRoot.AssemblyLinearVelocity, speed = stats and (stats.vZid or stats.vMax) or 200, hazards = hazards, floor = (World.MaxTeren or 395) + 130, ceiling = World.ZonaPlafon, zoneRadius = World.ZonaRadijus, previous = previousMovement, blocked = function(direction) return workspace:Raycast(ownRoot.Position, direction * 160, obstacleParams) ~= nil end}, result.movement)
			end
		end
		if defenseChanged and not obstruction and not collision then result.movement, result.mode = defenseMovement, "탄로 예측 회피" end
		if jump and (now > jump.untilTime or (jump.part and not jump.part.Parent)) then jump = nil end
		collectPickup(now)
		if settings.blink and defenseUrgent and not jump and now >= jumpAt and not Status.Aktivno(ownPlane, "stit") then
			local point = ownRoot.Position + result.movement * 180
			point = Vector3.new(point.X, math.max(point.Y, (World.MaxTeren or 395) + 180), point.Z)
			if safePoint(point) then
				jump = {position = point, untilTime = now + 0.12, reason = "긴급 순간 회피"}
				jumpAt = now + 1.1
			end
		end
		if jump then result.mode, result.fire = jump.reason, false end
	end
	state = result
	local previous = targetModel
	targetModel = result.target and result.target.id or nil
	if previous ~= targetModel then
		clear = false
		if settings.mode == "Rage" and targetModel then
			local targetRoot = roots(targetModel)
			if targetRoot then
				local hit = workspace:Raycast(ownRoot.Position, targetRoot.Position - ownRoot.Position, sightParams)
				clear = not hit or hit.Instance:IsDescendantOf(targetModel)
			end
		end
		result.fire = result.fire and clear
	end
	Controls.cilj = result.direction
	Controls.pucaPrimarno = result.fire and mod.oruzje ~= false
	Controls.pucaSekundarno, Controls.pucaTercijarno = false, false
	local lock = Combat.cilj
	if settings.secondary and mod.oruzje ~= false and mod.zahvat ~= false and lock and lock.model == targetModel and (result.mode == "사격" or (settings.mode == "Rage" and result.fire)) and now >= secondaryAt then
		if lock.zakljucan or (not lock.vodjeno and result.distance < 600) then
			Controls.pucaSekundarno = true
			secondaryAt = now + (settings.mode == "Rage" and 0.12 or 0.7)
			if settings.mode == "Rage" then
				Controls.pucaSekundarno = weapon.slots[2] == true
				Controls.pucaTercijarno = weapon.slots[3] == true
			end
		end
	end
	return {cilj = result.direction, roll = 0, yaw = 0, boost = result.boost, _flightCombat = settings.mode == "Rage" and rageToken or nil}
end

local function installRageStep()
	local base = FlightModel.Korak
	assert(type(base) == "function", "기체 제어 함수를 찾지 못했습니다.")
	originalStep = base
	local handler
	handler = function(model, dt, input)
		local cf, velocity = base(model, dt, input)
		if not enabled or wrappedStep ~= handler or settings.mode ~= "Rage" or input._flightCombat ~= rageToken then return cf, velocity end
		if not ownRoot or not ownRoot.Parent or not state.snap or (model.mod and model.mod.kontrole == false) then return cf, velocity end
		local success, frame, motion = pcall(function()
			local up = math.abs(state.direction:Dot(Vector3.new(0, 1, 0))) > 0.98 and Vector3.new(0, 0, 1) or Vector3.new(0, 1, 0)
			local position = jump and jump.position or ownRoot.Position
			if jump and not jump.applied then
				jump.applied = true
				samples[ownRoot] = {position = position, time = os.clock(), velocity = Vector3.zero}
			end
			local snapped = CFrame.lookAt(position, position + state.direction, up)
			local speed = model.stat.vZid or model.stat.vMax
			local movement = state.movement or state.direction
			ownRoot.CFrame = snapped
			model.cf, model.smer, model.rate, model.v = snapped, movement, Vector3.zero, speed
			rageFlight = model
			return snapped, jump and Vector3.zero or movement * speed
		end)
		if not success then
			stop()
			window:Notify({Title = "자동 전투 중지", Content = tostring(frame), Kind = "Danger"})
			return cf, velocity
		end
		return frame, motion
	end
	wrappedStep = handler
	FlightModel.Korak = handler
end

local function start()
	if enabled or destroyed then return end
	if settings.mode == "Rage" then installRageStep() end
	local base = Controls.Azuriraj
	original = base
	local handler
	handler = function(dt, rig, cf)
		local input = base(dt, rig, cf)
		if not enabled or wrapped ~= handler then return input end
		if not Controls.aktivno then
			releaseFire()
			pilot:Reset()
			ragePilot:Reset()
			state = {mode = "출격 대기", fire = false}
			return input
		end
		local success, result = pcall(update, math.min(dt, 0.1), cf)
		if not success then
			stop()
			window:Notify({Title = "자동 전투 중지", Content = tostring(result), Kind = "Danger"})
			return input
		end
		return result or input
	end
	wrapped = handler
	Controls.Azuriraj = wrapped
	enabled = true
	scanAt = 0
	pilot:Reset()
	ragePilot:Reset()
end

local function selectMode(mode, value)
	if value then
		if enabled then stop() end
		settings.mode = mode
		start()
		if toggle then toggle:Set(mode == "Legit", true) end
		if rageToggle then rageToggle:Set(mode == "Rage", true) end
	elseif settings.mode == mode then stop() end
end
